---
import ContactForm from './ContactForm.astro';
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
// The contact page has the full form and the thank-you page just used one,
// so the footer form steps aside on both.
const path = Astro.url.pathname;
const showForm = !path.startsWith(`${base}contact`) && !path.startsWith(`${base}thanks`);
---
<footer class="site-footer">
  {showForm && (
    <>
      <hr class="hairline" />
      <section class="container say-hello" aria-labelledby="footer-form-title">
        <div class="intro">
          <p class="eyebrow">~/say-hello</p>
          <h2 id="footer-form-title">Get in touch</h2>
          <p>Something here worth talking about? Leave your name and email and I'll write back.</p>
        </div>
        <ContactForm variant="compact" location="footer" />
      </section>
    </>
  )}
  <hr class="hairline" />
  <div class="container inner">
    <!-- The category phrase links to its definition page on every page (SEO/AEO) -->
    <span class="label">© {year} Bronson Harrington - <a href={`${base}growth-architect-costa-rica/`} class="gacr">Growth Architect, Costa Rica</a></span>
    <div class="links">
      <a href={`${base}rss.xml`} class="label">rss</a>
      <a href="https://github.com/Gnuboss" class="label">github</a>
      <a href="https://www.linkedin.com/in/bronsonharrington/" class="label">linkedin</a>
      <a href="mailto:im@bronson.co.za" class="label">im@bronson.co.za</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
  }
  .say-hello {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-5);
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }
  .say-hello h2 {
    font-size: var(--text-xl);
    margin: var(--space-1) 0 var(--space-2);
  }
  .say-hello .intro p:last-child {
    color: var(--ink-muted);
  }
  @media (max-width: 860px) {
    .say-hello { grid-template-columns: 1fr; gap: var(--space-3); }
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    padding-bottom: var(--space-4);
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .links {
    display: flex;
    gap: var(--space-3);
  }
  .links a {
    text-decoration: none;
    color: var(--ink-faint);
  }
  .gacr {
    color: inherit;
    text-underline-offset: 3px;
    text-decoration-color: var(--hairline);
  }
  .gacr:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .links a:hover {
    color: var(--accent);
  }
</style>

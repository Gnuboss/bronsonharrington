---
import Monogram from './Monogram.astro';
const base = import.meta.env.BASE_URL;
const nav = [
  { label: 'field notes', href: `${base}notes/` },
  { label: 'lab', href: `${base}lab/` },
  { label: 'framework', href: `${base}framework/` },
  { label: 'about', href: `${base}about-me/` },
  { label: 'contact', href: `${base}contact/`, cta: true },
];
---
<header class="site-header">
  <div class="container inner">
    <a href={base} class="wordmark"><Monogram variant="dark" size="1.25rem" label="" /><span>Bronson Harrington</span></a>
    <nav aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} class:list={{ cta: item.cta }}>{item.label}{item.cta && <span aria-hidden="true"> →</span>}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 0.5px solid var(--hairline);
    background: var(--paper);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-base);
    text-decoration: none;
    color: var(--ink);
  }
  nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--ink-muted);
  }
  nav a:hover {
    color: var(--ink);
  }
  /* Contact doubles as the header CTA */
  nav a.cta {
    color: var(--paper);
    background: var(--ink);
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius);
  }
  nav a.cta:hover {
    color: var(--paper);
    background: var(--accent);
  }
  /* Five links don't fit beside the name on a phone: stack the name above the nav */
  @media (max-width: 720px) {
    .inner { flex-direction: column; align-items: flex-start; gap: var(--space-1); }
    nav ul { gap: var(--space-2); flex-wrap: wrap; }
    nav a { font-size: var(--text-xs); }
    /* On phones the top bar already carries email and call, so contact goes back to a plain link */
    nav a.cta { background: none; color: var(--ink-muted); padding: 0; }
    nav a.cta span { display: none; }
  }
</style>

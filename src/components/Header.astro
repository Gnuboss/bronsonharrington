---
const base = import.meta.env.BASE_URL;
const nav = [
  { label: 'notes', href: `${base}notes/` },
  { label: 'lab', href: `${base}lab/` },
  { label: 'framework', href: `${base}framework/` },
  { label: 'about', href: `${base}about-me/` },
  { label: 'contact', href: `${base}contact/` },
];
---
<header class="site-header">
  <div class="container inner">
    <a href={base} class="wordmark">Bronson Harrington</a>
    <nav aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 0.5px solid var(--hairline);
    background: var(--paper);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-base);
    text-decoration: none;
    color: var(--ink);
  }
  nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--ink-muted);
  }
  nav a:hover {
    color: var(--ink);
  }
  /* Five links don't fit beside the name on a phone: stack the name above the nav */
  @media (max-width: 720px) {
    .inner { flex-direction: column; align-items: flex-start; gap: var(--space-1); }
    nav ul { gap: var(--space-2); flex-wrap: wrap; }
    nav a { font-size: var(--text-xs); }
  }
</style>

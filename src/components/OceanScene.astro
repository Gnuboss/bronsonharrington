---
// The ocean dive: an original SVG scene split into layers that move at
// different speeds as you scroll (parallax), so reading the page feels like
// diving: sky, surface, open water, seabed. Clouds drift, fish swim.
// Used by the lab scroller (/lab/scroller/) and the home page design test.
//
// Props
//   marks   depth gauge entries: { id, depth, label }; each mark is pinned to
//           where the needle sits when the section with that id is centred
//   seabed  id of the section the seabed should sit behind (usually the last)
//
// Performance: every layer is drawn once; scrolling only changes each layer's
// transform (compositor only). Reduced motion: the scene stays still.
// Colours come from the palette tokens, so it reskins with each edition.

import { palette } from '../config/palette.mjs';
import { buildTokens, contrastChecks, mix } from '../config/theme.mjs';

// The reef: the contact form and footer become dark rock at the bottom of
// the dive. Same palette, roles flipped: rock is the background, paper is
// the text, and the light highlight colour takes over links. buildTokens
// runs the usual contrast fixes, and the build fails if any pair misses AA.
const roles = palette.roles;
const rock = mix(roles.ink, '#000000', 0.78);
const reef = buildTokens({
  roles: { paper: rock, ink: roles.paper, accent: roles.highlight, rule: roles.rule, highlight: roles.highlight },
});
const failing = contrastChecks(reef).filter((c) => c.ratio < c.min);
if (failing.length) throw new Error(`Reef colours fail contrast: ${failing.map((c) => c.pair).join(', ')}`);
// Reef edge shapes, generated once (scripts in the field note): a rough line of
// boulders, and branching / fan / tube coral that rises behind them
const ROCK_AND_CORAL = `:root{--rock-mask:url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1440 120'><path d='M0 120 L0 72 Q14 45 56 49 Q94 54 107 63 Q117 69 147 75 Q172 78 181 60 Q189 74 214 72 Q244 75 254 64 Q266 29 302 34 Q354 35 372 52 Q387 39 434 37 Q468 48 479 53 Q483 47 494 43 Q521 50 530 88 Q543 42 582 45 Q603 47 610 91 Q624 43 667 42 Q704 53 716 80 Q729 49 768 46 Q794 56 803 92 Q811 54 836 54 Q875 59 888 57 Q895 48 916 45 Q954 57 967 74 Q974 55 996 57 Q1021 56 1030 86 Q1035 37 1050 36 Q1074 37 1082 92 Q1096 56 1138 53 Q1178 65 1192 67 Q1208 68 1255 65 Q1305 72 1322 75 Q1337 80 1382 77 Q1426 82 1440 72 L1440 120 Z'/></svg>");--coral-mask:url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1440 120'><g fill='%23000' stroke='%23000' stroke-linecap='round'><path d='M40 90 L38 64' stroke-width='7.2'/><path d='M38 64 L42 48' stroke-width='5.2'/><path d='M42 48 L50 40' stroke-width='3.7'/><path d='M50 40 L57 37' stroke-width='2.7'/><path d='M50 40 L53 33' stroke-width='2.7'/><path d='M42 48 L42 37' stroke-width='3.7'/><path d='M42 37 L46 31' stroke-width='2.7'/><path d='M42 37 L38 30' stroke-width='2.7'/><path d='M38 64 L30 46' stroke-width='5.2'/><path d='M30 46 L31 33' stroke-width='3.7'/><path d='M31 33 L35 24' stroke-width='2.7'/><path d='M31 33 L30 23' stroke-width='2.7'/><path d='M30 46 L21 37' stroke-width='3.7'/><path d='M21 37 L18 29' stroke-width='2.7'/><path d='M21 37 L14 33' stroke-width='2.7'/><path d='M161 90 L160 61' stroke-width='7.0'/><path d='M160 61 L169 42' stroke-width='5.1'/><path d='M169 42 L182 35' stroke-width='3.7'/><path d='M182 35 L190 33' stroke-width='2.6'/><path d='M182 35 L188 27' stroke-width='2.6'/><path d='M169 42 L171 29' stroke-width='3.7'/><path d='M171 29 L176 21' stroke-width='2.6'/><path d='M171 29 L169 20' stroke-width='2.6'/><path d='M160 61 L151 42' stroke-width='5.1'/><path d='M151 42 L151 28' stroke-width='3.7'/><path d='M151 28 L156 21' stroke-width='2.6'/><path d='M151 28 L149 18' stroke-width='2.6'/><path d='M151 42 L140 31' stroke-width='3.7'/><path d='M140 31 L137 21' stroke-width='2.6'/><path d='M140 31 L130 28' stroke-width='2.6'/><path d='M337 90 L332 63' stroke-width='7.4'/><path d='M332 63 L338 45' stroke-width='5.3'/><path d='M338 45 L345 36' stroke-width='3.8'/><path d='M345 36 L354 33' stroke-width='2.8'/><path d='M345 36 L347 29' stroke-width='2.8'/><path d='M338 45 L337 32' stroke-width='3.8'/><path d='M337 32 L341 25' stroke-width='2.8'/><path d='M337 32 L332 24' stroke-width='2.8'/><path d='M332 63 L325 48' stroke-width='5.3'/><path d='M325 48 L325 37' stroke-width='3.8'/><path d='M325 37 L328 30' stroke-width='2.8'/><path d='M325 37 L321 30' stroke-width='2.8'/><path d='M325 48 L315 42' stroke-width='3.8'/><path d='M315 42 L312 35' stroke-width='2.8'/><path d='M315 42 L308 39' stroke-width='2.8'/><rect x='436' y='41' width='8' height='79' rx='4'/><rect x='447' y='40' width='8' height='80' rx='4'/><rect x='458' y='52' width='8' height='68' rx='4'/><path d='M575 90 L576 59' stroke-width='9.2'/><path d='M576 59 L583 38' stroke-width='6.6'/><path d='M583 38 L595 25' stroke-width='4.8'/><path d='M595 25 L604 20' stroke-width='3.4'/><path d='M595 25 L598 13' stroke-width='3.4'/><path d='M583 38 L581 23' stroke-width='4.8'/><path d='M581 23 L583 11' stroke-width='3.4'/><path d='M581 23 L575 13' stroke-width='3.4'/><path d='M576 59 L568 38' stroke-width='6.6'/><path d='M568 38 L569 25' stroke-width='4.8'/><path d='M569 25 L574 16' stroke-width='3.4'/><path d='M569 25 L565 16' stroke-width='3.4'/><path d='M568 38 L558 26' stroke-width='4.8'/><path d='M558 26 L555 16' stroke-width='3.4'/><path d='M558 26 L548 23' stroke-width='3.4'/><path d='M750 90 L752 63' stroke-width='8.4'/><path d='M752 63 L763 47' stroke-width='6.1'/><path d='M763 47 L775 40' stroke-width='4.4'/><path d='M775 40 L784 38' stroke-width='3.2'/><path d='M775 40 L782 34' stroke-width='3.2'/><path d='M763 47 L765 35' stroke-width='4.4'/><path d='M765 35 L771 27' stroke-width='3.2'/><path d='M765 35 L763 27' stroke-width='3.2'/><path d='M752 63 L744 47' stroke-width='6.1'/><path d='M744 47 L744 36' stroke-width='4.4'/><path d='M744 36 L747 28' stroke-width='3.2'/><path d='M744 36 L739 28' stroke-width='3.2'/><path d='M744 47 L735 38' stroke-width='4.4'/><path d='M735 38 L733 31' stroke-width='3.2'/><path d='M735 38 L727 35' stroke-width='3.2'/><path d='M865 90 L860 60' stroke-width='9.5'/><path d='M860 60 L867 41' stroke-width='6.8'/><path d='M867 41 L877 30' stroke-width='4.9'/><path d='M877 30 L887 26' stroke-width='3.5'/><path d='M877 30 L880 19' stroke-width='3.5'/><path d='M867 41 L866 27' stroke-width='4.9'/><path d='M866 27 L870 17' stroke-width='3.5'/><path d='M866 27 L861 18' stroke-width='3.5'/><path d='M860 60 L848 45' stroke-width='6.8'/><path d='M848 45 L846 31' stroke-width='4.9'/><path d='M846 31 L849 21' stroke-width='3.5'/><path d='M846 31 L842 23' stroke-width='3.5'/><path d='M848 45 L837 39' stroke-width='4.9'/><path d='M837 39 L830 32' stroke-width='3.5'/><path d='M837 39 L829 40' stroke-width='3.5'/><path d='M952 90 A36 36 0 0 1 1024 90 Z'/><path d='M1123 90 L1119 60' stroke-width='7.5'/><path d='M1119 60 L1128 42' stroke-width='5.4'/><path d='M1128 42 L1138 33' stroke-width='3.9'/><path d='M1138 33 L1147 32' stroke-width='2.8'/><path d='M1138 33 L1142 25' stroke-width='2.8'/><path d='M1128 42 L1129 27' stroke-width='3.9'/><path d='M1129 27 L1134 17' stroke-width='2.8'/><path d='M1129 27 L1125 19' stroke-width='2.8'/><path d='M1119 60 L1106 43' stroke-width='5.4'/><path d='M1106 43 L1104 28' stroke-width='3.9'/><path d='M1104 28 L1108 17' stroke-width='2.8'/><path d='M1104 28 L1100 19' stroke-width='2.8'/><path d='M1106 43 L1091 37' stroke-width='3.9'/><path d='M1091 37 L1082 29' stroke-width='2.8'/><path d='M1091 37 L1080 37' stroke-width='2.8'/><path d='M1248 90 L1251 58' stroke-width='9.9'/><path d='M1251 58 L1260 38' stroke-width='7.2'/><path d='M1260 38 L1270 27' stroke-width='5.2'/><path d='M1270 27 L1280 22' stroke-width='3.7'/><path d='M1270 27 L1274 19' stroke-width='3.7'/><path d='M1260 38 L1261 22' stroke-width='5.2'/><path d='M1261 22 L1265 12' stroke-width='3.7'/><path d='M1261 22 L1258 11' stroke-width='3.7'/><path d='M1251 58 L1247 35' stroke-width='7.2'/><path d='M1247 35 L1253 20' stroke-width='5.2'/><path d='M1253 20 L1260 13' stroke-width='3.7'/><path d='M1253 20 L1254 9' stroke-width='3.7'/><path d='M1247 35 L1237 20' stroke-width='5.2'/><path d='M1237 20 L1233 7' stroke-width='3.7'/><path d='M1237 20 L1225 13' stroke-width='3.7'/><path d='M1369 90 L1370 56' stroke-width='7.9'/><path d='M1370 56 L1379 34' stroke-width='5.7'/><path d='M1379 34 L1393 22' stroke-width='4.1'/><path d='M1393 22 L1405 18' stroke-width='2.9'/><path d='M1393 22 L1400 9' stroke-width='2.9'/><path d='M1379 34 L1378 18' stroke-width='4.1'/><path d='M1378 18 L1380 7' stroke-width='2.9'/><path d='M1378 18 L1372 9' stroke-width='2.9'/><path d='M1370 56 L1363 33' stroke-width='5.7'/><path d='M1363 33 L1366 17' stroke-width='4.1'/><path d='M1366 17 L1375 7' stroke-width='2.9'/><path d='M1366 17 L1363 6' stroke-width='2.9'/><path d='M1363 33 L1352 21' stroke-width='4.1'/><path d='M1352 21 L1348 10' stroke-width='2.9'/><path d='M1352 21 L1341 16' stroke-width='2.9'/></g></svg>")}`;
const reefCss =
  'html:has(.scene) .site-footer{' +
  Object.entries(reef).map(([k, v]) => `${k}:${v}`).join(';') +
  `;--coral:${mix(roles.rule, rock, 0.55)};--coral-2:${mix(roles.highlight, rock, 0.45)}}`;

interface Mark { id?: string; depth: string; label: string; at?: number }
interface Props { marks: Mark[]; seabed: string }
const { marks: given, seabed } = Astro.props;
// Rough starting positions until the script measures the real ones
const marks = given.map((m, i) => ({ ...m, at: m.at ?? i / Math.max(1, given.length - 1) * 0.85 }));

// Deterministic "random" so the scene is the same on every build
let seed = 7;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const range = (a: number, b: number) => a + rand() * (b - a);

// Pieces are positioned in % of their layer, so the scene fits any screen.
const clouds = Array.from({ length: 9 }, () => {
  const w = range(14, 30);
  // Bigger clouds read as closer, so they drift a little faster
  const dur = 260 - w * 5 + range(-15, 15);
  const x = range(-5, 90);
  // A negative delay starts each cloud part-way across, where it was placed
  return { x, y: range(2, 22), w, o: range(0.5, 0.95), dur, delay: -((x + 35) / 140) * dur };
});
const rays = Array.from({ length: 7 }, (_, i) => ({ x: 6 + i * 14 + range(-4, 4), w: range(4, 9), skew: range(-10, 10), o: range(0.08, 0.18) }));
const kelp = Array.from({ length: 16 }, () => ({ x: range(0, 98), h: range(14, 34), sway: range(3, 7), delay: range(0, 4) }));
const fish = Array.from({ length: 6 }, (_, i) => ({ y: 30 + i * 11 + range(-3, 3), n: Math.round(range(4, 9)), dir: rand() > 0.5 ? 1 : -1, dur: range(28, 48), delay: range(-40, 0), s: range(0.7, 1.3) }));
const stones = Array.from({ length: 14 }, () => ({ x: range(-2, 96), w: range(5, 14), h: range(2, 5) }));
const bubbles = Array.from({ length: 22 }, () => ({ x: range(2, 98), y: range(35, 95), r: range(2, 6), dur: range(8, 16), delay: range(-16, 0) }));

---
  <!-- The scene: fixed behind the page, one element per layer -->
  <div class="scene" aria-hidden="true" data-seabed={seabed}>
    <div class="layer sky" data-speed="0.08">
      <svg class="sun" viewBox="0 0 100 100"><circle cx="50" cy="50" r="46" /></svg>
    </div>

    <div class="layer clouds" data-speed="0.22">
      {clouds.map((c) => (
        <svg class="cloud" viewBox="0 0 120 40" style={`top:${c.y}%;width:${c.w}vw;opacity:${c.o};--dur:${c.dur}s;--delay:${c.delay}s`}>
          <path d="M10 34 Q4 34 4 27 Q4 19 13 19 Q15 9 27 9 Q36 2 48 8 Q58 2 70 9 Q84 8 88 18 Q100 17 104 25 Q116 26 116 31 Q116 35 108 35 Z" />
        </svg>
      ))}
    </div>

    <div class="layer sea" data-speed="0.55">
      <svg class="islands" viewBox="0 0 1440 120" preserveAspectRatio="none">
        <path d="M0 120 L0 104 Q120 92 210 100 Q300 70 380 96 Q460 104 560 110 L560 120 Z" />
        <path d="M900 120 L900 108 Q980 86 1050 98 Q1120 60 1210 92 Q1300 100 1440 96 L1440 120 Z" />
      </svg>
      <div class="water">
        <!-- One wave period (240 units) wider than the screen, so sliding it
             left by one period loops seamlessly -->
        <div class="tide">
          <svg class="waves" viewBox="0 0 1680 40" preserveAspectRatio="none">
            <path d="M0 14 Q60 4 120 14 T240 14 T360 14 T480 14 T600 14 T720 14 T840 14 T960 14 T1080 14 T1200 14 T1320 14 T1440 14 T1560 14 T1680 14 L1680 40 L0 40 Z" />
          </svg>
        </div>
      </div>
    </div>

    <div class="layer rays" data-speed="0.7">
      {rays.map((r) => (
        <svg class="ray" viewBox="0 0 10 100" preserveAspectRatio="none" style={`left:${r.x}%;width:${r.w}vw;opacity:${r.o};transform:skewX(${r.skew}deg)`}>
          <path d="M3 0 L7 0 L10 100 L0 100 Z" />
        </svg>
      ))}
    </div>

    <div class="layer life" data-speed="0.85">
      {fish.map((f) => (
        <div class="school" style={`top:${f.y}%;--dur:${f.dur}s;--delay:${f.delay}s;--dir:${f.dir};--s:${f.s}`}>
          <svg viewBox={`0 0 ${f.n * 18} 20`} style={`width:${f.n * 18 * f.s}px`}>
            {Array.from({ length: f.n }, (_, i) => (
              <path transform={`translate(${i * 18} ${(i % 3) * 4})`} d="M0 6 Q6 0 12 6 Q6 12 0 6 Z M12 6 L16 2 L16 10 Z" />
            ))}
          </svg>
        </div>
      ))}
      {bubbles.map((b) => (
        <span class="bubble" style={`left:${b.x}%;top:${b.y}%;width:${b.r}px;height:${b.r}px;--dur:${b.dur}s;--delay:${b.delay}s`}></span>
      ))}
    </div>

    <div class="layer seabed" data-speed="1">
      <div class="floor">
        {kelp.map((k) => (
          <svg class="kelp" viewBox="0 0 20 100" preserveAspectRatio="none" style={`left:${k.x}%;height:${k.h}vh;--sway:${k.sway}deg;--delay:${k.delay}s`}>
            <path d="M10 100 Q2 80 10 60 Q18 40 10 20 Q4 8 10 0" />
          </svg>
        ))}
        <svg class="sand" viewBox="0 0 1440 80" preserveAspectRatio="none">
          <path d="M0 30 Q180 10 360 26 T720 22 T1080 28 T1440 18 L1440 80 L0 80 Z" />
        </svg>
        {stones.map((s) => (
          <svg class="stone" viewBox="0 0 100 50" preserveAspectRatio="none" style={`left:${s.x}%;width:${s.w}vw;height:${s.h}vw`}>
            <path d="M0 50 Q8 8 50 4 Q92 8 100 50 Z" />
          </svg>
        ))}
      </div>
    </div>
  </div>

  <!-- Depth gauge, like a game HUD -->
  <nav class="gauge" aria-label="Depth">
    <ol>
      {marks.map((m) => (
        <li style={`top:${m.at * 100}%`} data-for={m.id ?? m.label}><a href={`#${m.id ?? m.label}`}><span class="d">{m.depth}</span> {m.label}</a></li>
      ))}
    </ol>
    <span class="needle" aria-hidden="true"></span>
  </nav>


<!-- Reef colours (flipped palette) and the rough rock / coral edge shapes -->
<style is:inline set:html={reefCss + ROCK_AND_CORAL}></style>

<style>

  /* Scene ---------------------------------------------------------------- */
  .scene {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: var(--paper);
  }
  .layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    /* Each layer is as tall as the distance it travels plus one screen */
    height: calc(100vh + var(--range, 3000px) * var(--speed, 1));
    will-change: transform;
  }
  .sky {
    background: linear-gradient(var(--paper), color-mix(in srgb, var(--accent) 6%, var(--paper)) 40%);
  }
  .sun {
    position: absolute;
    right: 12%;
    top: 9vh;
    width: min(18vw, 160px);
    fill: color-mix(in srgb, var(--accent) 55%, var(--paper));
  }
  .cloud {
    position: absolute;
    left: 0;
    fill: var(--paper-dim);
    /* Slow drift left to right; transform only, so it stays on the compositor */
    animation: drift var(--dur) linear infinite;
    animation-delay: var(--delay);
    /* Rasterise each cloud once; the compositor only slides the bitmap */
    will-change: transform;
    contain: strict;
    aspect-ratio: 3;
  }
  @keyframes drift {
    from { transform: translateX(-35vw); }
    to { transform: translateX(105vw); }
  }

  /* The sea starts a short way down its layer, so the surface arrives early */
  .sea .islands {
    position: absolute;
    left: 0;
    width: 100%;
    top: calc(55vh - 60px);
    height: 60px;
    fill: color-mix(in srgb, var(--ink) 35%, var(--paper));
  }
  .sea .water {
    position: absolute;
    left: 0;
    right: 0;
    top: 55vh;
    bottom: 0;
    /* Darker the deeper you go */
    background: linear-gradient(
      color-mix(in srgb, var(--ink) 28%, var(--paper)),
      color-mix(in srgb, var(--ink) 60%, var(--paper)) 45%,
      color-mix(in srgb, var(--ink) 88%, var(--paper))
    );
  }
  /* The waterline: the waves roll sideways while the tide slowly rises and
     falls. Both are transform-only loops, so they stay on the compositor */
  .tide {
    position: absolute;
    top: -14px;
    left: 0;
    width: 100%;
    height: 28px;
  }
  .waves {
    display: block;
    width: calc(100vw * 1680 / 1440);
    height: 100%;
    fill: color-mix(in srgb, var(--ink) 28%, var(--paper));
    /* One element, two loops: roll uses transform, tide uses translate */
    animation: roll 14s linear infinite, tide 9s ease-in-out infinite alternate;
    will-change: transform, translate;
    /* Without strict containment the moving waves repaint the layer they sit in */
    contain: strict;
  }
  @keyframes roll {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100vw * 240 / 1440)); }
  }
  @keyframes tide {
    from { translate: 0 -4px; }
    to { translate: 0 5px; }
  }

  .rays {
    /* Light only reaches the upper water */
    top: calc(55vh + var(--range, 3000px) * 0.12);
  }
  .ray {
    position: absolute;
    top: 0;
    height: 70vh;
    fill: var(--paper);
    transform-origin: top;
    mix-blend-mode: soft-light;
  }

  .life {
    top: calc(55vh + var(--range, 3000px) * 0.15);
  }
  .school {
    position: absolute;
    left: 0;
    width: 100%;
    animation: swim var(--dur) linear infinite;
    animation-delay: var(--delay);
  }
  .school svg {
    display: block;
    fill: color-mix(in srgb, var(--accent) 70%, var(--ink));
    opacity: 0.55;
    /* Fish are drawn facing left: mirror them when the school swims right */
    transform: scaleX(calc(var(--dir) * -1));
  }
  @keyframes swim {
    from { transform: translateX(calc(-30vw * var(--dir) + 50vw - 50vw * var(--dir))); }
    to { transform: translateX(calc(130vw * var(--dir) + 50vw - 50vw * var(--dir))); }
  }
  .bubble {
    position: absolute;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--paper) 60%, transparent);
    animation: rise var(--dur) linear infinite;
    animation-delay: var(--delay);
  }
  @keyframes rise {
    from { transform: translateY(0); opacity: 0; }
    15% { opacity: 1; }
    to { transform: translateY(-40vh); opacity: 0; }
  }

  /* The seabed sits just above the shared footer, so it's reached before
     the contact form scrolls over it */
  .seabed .floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--footer, 0px) + var(--below, 0px));
    height: 60vh;
  }
  /* Bedrock below the seabed, down to the bottom of the dive */
  .seabed .floor::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: calc(var(--footer, 0px) + var(--below, 0px) + 10px);
    background:
      repeating-linear-gradient(transparent 0 46px, rgba(var(--ink-rgb), 0.14) 46px 48px, transparent 48px 86px, rgba(var(--ink-rgb), 0.08) 86px 87px),
      color-mix(in srgb, var(--paper) 42%, var(--ink));
  }
  .kelp {
    position: absolute;
    bottom: 40px;
    width: 26px;
    fill: none;
    stroke: color-mix(in srgb, var(--accent) 45%, var(--ink));
    stroke-width: 3;
    stroke-linecap: round;
    transform-origin: bottom;
    animation: sway 6s ease-in-out infinite alternate;
    animation-delay: var(--delay);
  }
  @keyframes sway {
    from { transform: rotate(calc(var(--sway) * -1)); }
    to { transform: rotate(var(--sway)); }
  }
  .sand {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 80px;
    fill: color-mix(in srgb, var(--paper) 42%, var(--ink));
  }
  .stone {
    position: absolute;
    bottom: 30px;
    fill: color-mix(in srgb, var(--ink) 75%, var(--paper));
  }

  /* Depth gauge ------------------------------------------------------------ */
  .gauge {
    position: fixed;
    right: 18px;
    top: 22vh;
    height: 56vh;
    width: 2px;
    background: color-mix(in srgb, var(--ink) 25%, transparent);
    z-index: 5;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .gauge ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .gauge li {
    position: absolute;
    right: 10px;
    transform: translateY(-50%);
    white-space: nowrap;
  }
  .gauge a {
    color: var(--ink);
    text-decoration: none;
    background: color-mix(in srgb, var(--paper) 85%, transparent);
    padding: 1px 6px;
    border-radius: var(--radius);
  }
  .gauge .d {
    color: var(--accent);
  }
  /* The gauge steps aside once you reach the reef */
  .gauge {
    transition: opacity 0.3s;
  }
  .gauge.away {
    opacity: 0;
    pointer-events: none;
  }
  .needle {
    position: absolute;
    left: -5px;
    top: 0;
    width: 12px;
    height: 2px;
    background: var(--accent);
  }

  /* The reef: the footer (and its contact form) as dark rock with a rough,
     coral-topped edge, anchoring the bottom of the dive. Its colours are
     the flipped reef tokens set inline above, so the form follows along */
  :global(.site-footer) {
    position: relative;
    background: var(--paper);
    color: var(--ink);
    margin-top: 110px;
    /* Rock continues below the footer (e.g. behind the phone thumb nav's spacer) */
    box-shadow: 0 50vh 0 50vh var(--paper);
  }
  :global(.site-footer::before),
  :global(.site-footer::after) {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
    -webkit-mask-repeat: repeat-x;
    mask-repeat: repeat-x;
    -webkit-mask-position: left bottom;
    mask-position: left bottom;
    -webkit-mask-size: 1440px 120px;
    mask-size: 1440px 120px;
  }
  /* Coral behind the rock, so the rock's edge sits in front of it */
  :global(.site-footer::after) {
    bottom: calc(100% - 1px);
    height: 120px;
    z-index: -1;
    background: linear-gradient(90deg, var(--coral) 0 50%, var(--coral-2) 50% 100%) 0 0 / 720px 100% repeat-x;
    -webkit-mask-image: var(--coral-mask);
    mask-image: var(--coral-mask);
  }
  :global(.site-footer::before) {
    bottom: calc(100% - 1px);
    height: 120px;
    background: var(--paper);
    -webkit-mask-image: var(--rock-mask);
    mask-image: var(--rock-mask);
  }
  :global(.site-footer > hr.hairline:first-child) {
    display: none;
  }

  @media (max-width: 720px) {
    .gauge li a { font-size: 0; padding: 0; background: none; }
    .gauge li a .d { font-size: var(--text-xs); background: color-mix(in srgb, var(--paper) 85%, transparent); padding: 1px 4px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .school, .bubble, .kelp, .tide, .waves { animation: none; }
    .cloud { animation-play-state: paused; }
  }
</style>

<script>
  // Parallax: each layer moves by scroll x its speed. Only transforms change,
  // so the browser can do it on the compositor without repainting the scene.
  const scene = document.querySelector<HTMLElement>('.scene');
  const layers = [...document.querySelectorAll<HTMLElement>('.scene .layer')];
  const root = document.documentElement;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const needle = document.querySelector<HTMLElement>('.gauge .needle');
  const gauge = document.querySelector<HTMLElement>('.gauge');
  const footerEl = document.querySelector<HTMLElement>('.site-footer');
  let gaugeH = 0;
  let range = 1;

  const measure = () => {
    range = Math.max(1, root.scrollHeight - innerHeight);
    root.style.setProperty('--range', `${range}px`);
    const footer = document.querySelector<HTMLElement>('.site-footer');
    root.style.setProperty('--footer', `${footer ? footer.offsetHeight : 0}px`);
    // Place the seabed so it fills the lower part of the screen when the
    // seabed card is centred: below = distance from that point to the footer
    const stop = document.getElementById(scene?.dataset.seabed ?? '');
    const footerH = footer ? footer.offsetHeight : 0;
    const below = stop ? root.scrollHeight - footerH - (stop.offsetTop + stop.offsetHeight / 2 + innerHeight * 0.5) : 0;
    root.style.setProperty('--below', `${Math.max(0, below)}px`);
    for (const l of layers) l.style.setProperty('--speed', l.dataset.speed ?? '1');
    gaugeH = gauge ? gauge.offsetHeight : 0;
    // Pin each gauge mark to where the needle is when its section is centred
    for (const li of document.querySelectorAll<HTMLElement>('.gauge li[data-for]')) {
      const el = document.getElementById(li.dataset.for ?? '');
      if (!el) continue;
      const at = (el.offsetTop + el.offsetHeight / 2 - innerHeight / 2) / range;
      li.style.top = `${(Math.min(1, Math.max(0, at)) * 100).toFixed(2)}%`;
    }
  };

  let ticking = false;
  const update = () => {
    ticking = false;
    const y = scrollY;
    if (!still) {
      for (const l of layers) l.style.transform = `translate3d(0, ${(-y * Number(l.dataset.speed)).toFixed(1)}px, 0)`;
    }
    // Move the needle directly: a page-wide CSS variable here would make the
    // browser restyle the whole document on every frame
    if (gauge && footerEl) gauge.classList.toggle('away', footerEl.getBoundingClientRect().top < innerHeight * 0.75);
    if (needle) needle.style.transform = `translate3d(0, ${(Math.min(1, y / range) * gaugeH).toFixed(1)}px, 0)`;
  };
  const onScroll = () => {
    if (!ticking) { ticking = true; requestAnimationFrame(update); }
  };

  measure();
  update();
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', () => { measure(); update(); }, { passive: true });
  addEventListener('load', () => { measure(); update(); });
</script>

---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StyleTile from '../../components/StyleTile.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { slug: note.slug }, props: { note } }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const base = import.meta.env.BASE_URL;
const { note } = Astro.props;
const { Content } = await note.render();
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const url = `https://bronson.co.za/notes/${note.slug}/`;
// Add the name suffix only while it keeps the title within ~60 characters
const withName = `${note.data.title} | Bronson Harrington`;
const pageTitle = note.data.seoTitle ?? (withName.length <= 60 ? withName : note.data.title);
---
<BaseLayout title={pageTitle} description={note.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": note.data.title,
    "description": note.data.description,
    "datePublished": fmt(note.data.date),
    "dateModified": fmt(note.data.updated ?? note.data.date),
    "url": url,
    "mainEntityOfPage": url,
    "keywords": note.data.tags.join(', '),
    "author": { "@id": "https://bronson.co.za/#/schema/person" },
    "isPartOf": { "@id": "https://bronson.co.za/notes/#blog" }
  })} />

  <article class="note">
    <!-- Header on the hang: the way back hangs in the margin, the title takes the content columns -->
    <header class="hero container hang">
      <a href={`${base}notes/`} class="hang-label tag back">~/field-notes</a>
      <div class="hang-body">
        <h1>{note.data.title}</h1>
        <p class="lede">{note.data.description}</p>
      </div>
    </header>

    <hr class="hairline" />

    <div class="container sec">
      {note.data.styleTile && <div class="tile-wrap"><StyleTile edition={note.data.styleTile} /></div>}
      <div class="hang">
        <!-- Metadata stays in the margin column beside the text (sticky on desktop) -->
        <aside class="hang-label meta" aria-label="About this note">
          <dl>
            <div><dt>published</dt><dd><time datetime={fmt(note.data.date)}>{fmt(note.data.date)}</time></dd></div>
            {note.data.updated && <div><dt>updated</dt><dd><time datetime={fmt(note.data.updated)}>{fmt(note.data.updated)}</time></dd></div>}
            {note.data.tags.length > 0 && <div><dt>tags</dt><dd>{note.data.tags.join(' / ')}</dd></div>}
          </dl>
        </aside>
        <div class="hang-body prose">
          <Content />
        </div>
      </div>
      <div class="hang note-foot">
        <span class="hang-label"></span>
        <a href={`${base}notes/`} class="hang-body more">← all field notes</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .back {
    text-decoration: none;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, var(--text-2xl));
  }
  .tile-wrap {
    margin-bottom: var(--space-6);
  }
  .meta dl {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }
  .meta dt {
    color: var(--ink-faint);
  }
  .meta dd {
    margin: 0;
    color: var(--ink);
  }
  @media (min-width: 720px) {
    .meta dl {
      display: block;
      position: sticky;
      top: var(--space-3);
      border-top: 2px solid var(--rule-strong);
      padding-top: var(--space-1);
    }
    .meta dl > div {
      padding: var(--space-1) 0;
      border-bottom: 0.5px solid var(--hairline);
    }
  }
  .prose {
    font-size: 1.0625rem;
  }
  .prose :global(h2:first-child),
  .prose :global(p:first-child) {
    margin-top: 0;
  }
  .prose :global(pre) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: var(--ink);
    color: var(--paper);
    padding: var(--space-3);
    overflow-x: auto;
    border-radius: var(--radius);
    margin: 0 0 var(--space-3);
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }
  .note-foot {
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 0.5px solid var(--hairline);
  }
</style>

---
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<BaseLayout
  title="Field Notes on SEO, AEO and Growth | Bronson Harrington"
  description="Field notes from Bronson Harrington on SEO, answer engine optimization, growth systems, digital sovereignty and the tools he builds. Read the latest."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    "@id": "https://bronson.co.za/notes/#blog",
    "name": "Field Notes - Bronson Harrington",
    "url": "https://bronson.co.za/notes/",
    "author": { "@id": "https://bronson.co.za/#/schema/person" },
    "blogPost": notes.map((n) => ({
      "@type": "BlogPosting",
      "headline": n.data.title,
      "url": `https://bronson.co.za/notes/${n.slug}/`,
      "datePublished": fmt(n.data.date)
    }))
  })} />

  <PageHero eyebrow="~/field-notes" title="Field Notes">
    <p class="lede">Writing on SEO and AEO, growth systems, digital sovereignty, and the things I build.</p>
  </PageHero>

  <hr class="hairline" />

  <!-- A dated sequence: rows with the date in the margin column -->
  <Section eyebrow="~/all" title="All field notes" hiddenTitle>
    {notes.length === 0 ? (
      <p class="empty">Nothing published yet.</p>
    ) : (
      <ol class="rows">
        {notes.map((note) => (
          <li>
            <a href={`${base}notes/${note.slug}/`} class="row hang">
              <time class="hang-label" datetime={fmt(note.data.date)}>{fmt(note.data.date)}</time>
              <div class="hang-body">
                <h3>{note.data.title}</h3>
                <p>{note.data.description}</p>
                {note.data.tags.length > 0 && <p class="label tags">{note.data.tags.join(' / ')}</p>}
              </div>
            </a>
          </li>
        ))}
      </ol>
    )}
  </Section>
</BaseLayout>

<style>
  .tags {
    margin-top: var(--space-1) !important;
    color: var(--ink-faint) !important;
  }
</style>

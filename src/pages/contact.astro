---
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { CONTACT } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { socialGroups } from '../data/socials';
import ContactForm from '../components/ContactForm.astro';

const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Contact Bronson Harrington | Growth Architect, Costa Rica"
  description="Get in touch with Bronson Harrington to compare notes on SEO and AEO, talk about a build, or follow up on something he wrote. Send a message."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact Bronson Harrington",
    "url": "https://bronson.co.za/contact/",
    "about": { "@id": "https://bronson.co.za/#/schema/person" }
  })} />

  <PageHero eyebrow="~/contact" title="Contact">
    <p class="lede">Want to compare notes, talk about a build, or follow up on something I've written? Pick a topic, leave your email, and I'll write back. Or email me directly.</p>
  </PageHero>

  <hr class="hairline" />

  <Section eyebrow="~/write" title="Write to me.">
    <div class="hang">
      <div class="hang-body">
        <ContactForm variant="full" location="contact" />
      </div>
    </div>
  </Section>

  <hr class="hairline" />

  <!-- Direct details read like a datasheet -->
  <Section eyebrow="~/direct" title="Direct." tight>
    <div class="hang">
      <dl class="spec hang-body">
        <div><dt>email</dt><dd><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd></div>
        <div><dt>phone</dt><dd><a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a></dd></div>
        <div><dt>based in</dt><dd>San José, Costa Rica</dd></div>
        <div><dt>works</dt><dd>Remotely, worldwide</dd></div>
      </dl>
    </div>
  </Section>

  <hr class="hairline" />

  <!-- Three genuine peer groups: one uniform row -->
  <Section eyebrow="~/elsewhere" title="Find Me Elsewhere.">
    <div class="g">
      {socialGroups.map((g) => (
        <div class="s-4 group">
          <h3 class="label">{g.label}</h3>
          <ul>
            {g.links.map((l) => (
              <li>
                <a href={l.href} rel={l.profile ? 'me noopener' : 'noopener'}>
                  <span class="s-name">{l.name}</span>
                  <span class="label">{l.handle}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>
</BaseLayout>

<style>
  /* The spec sheet sits inside the content columns here, so its own rows
     drop the hang split and run key-over-value on narrow widths */
  .spec.hang-body > div {
    grid-template-columns: 8rem 1fr;
  }
  .spec.hang-body dt,
  .spec.hang-body dd {
    grid-column: auto;
  }
  .spec a {
    color: var(--ink);
  }
  .spec a:hover {
    color: var(--accent);
  }
  .group h3 {
    font-weight: 400;
    margin-bottom: var(--space-1);
  }
  .group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--rule-strong);
  }
  .group li {
    border-bottom: 0.5px solid var(--hairline);
  }
  .group a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-2) 0;
    text-decoration: none;
  }
  .s-name {
    color: var(--ink);
  }
  .group a:hover .s-name {
    color: var(--accent);
  }
  @media (min-width: 720px) and (max-width: 979px) {
    .group.s-4 { grid-column: span 8; }
  }
</style>

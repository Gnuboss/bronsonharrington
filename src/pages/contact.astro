---
import BaseLayout from '../layouts/BaseLayout.astro';
import { socialGroups } from '../data/socials';
import ContactForm from '../components/ContactForm.astro';

const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Contact Bronson Harrington | Growth Architect, Costa Rica"
  description="Get in touch with Bronson Harrington to compare notes on SEO and AEO, talk about a build, or follow up on something he wrote. Send a message."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact Bronson Harrington",
    "url": "https://bronson.co.za/contact/",
    "about": { "@id": "https://bronson.co.za/#/schema/person" }
  })} />

  <section class="hero container">
    <p class="eyebrow">~/contact</p>
    <h1>Contact</h1>
    <p class="lede">Want to compare notes, talk about a build, or follow up on something I've written? Pick a topic, leave your email, and I'll write back. Or email me directly.</p>
  </section>

  <hr class="hairline" />

  <section class="form-section container">
    <h2>Write to me</h2>
    <ContactForm variant="full" location="contact" />
  </section>

  <section class="info-strip container">
    <div class="info-block">
      <p class="label">email</p>
      <a href="mailto:im@bronson.co.za" class="info-value">im@bronson.co.za</a>
    </div>
    <div class="info-block">
      <p class="label">location</p>
      <p class="info-value">San José, Costa Rica</p>
    </div>
  </section>

  <section class="elsewhere container">
    <p class="eyebrow">~/elsewhere</p>
    <h2>Find Me Elsewhere.</h2>
    <div class="social-grid">
      {socialGroups.map((g) => (
        <div class="social-group">
          <h3 class="label">{g.label}</h3>
          <ul>
            {g.links.map((l) => (
              <li>
                <a href={l.href} rel={l.profile ? 'me noopener' : 'noopener'}>
                  <span class="s-name">{l.name}</span>
                  <span class="label s-handle">{l.handle}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-6);
    padding-bottom: var(--space-5);
  }
  .hero .lede {
    font-size: var(--text-lg);
    color: var(--ink-soft);
    max-width: var(--content-narrow);
    margin-top: var(--space-2);
  }
  .form-section {
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }
  .form-section h2 {
    margin-bottom: var(--space-3);
  }
  .info-strip {
    padding-top: var(--space-6);
    display: flex;
    border-top: 0.5px solid var(--hairline);
    border-bottom: 0.5px solid var(--hairline);
  }
  .info-block {
    flex: 1;
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    border-right: 0.5px solid var(--hairline);
  }
  .info-block:last-child {
    border-right: none;
    padding-right: 0;
  }
  .info-block + .info-block {
    padding-left: var(--space-4);
  }
  .info-value {
    display: block;
    font-size: var(--text-base);
    color: var(--ink);
    text-decoration: none;
    margin-top: var(--space-1);
  }
  a.info-value:hover {
    color: var(--accent);
  }
  .elsewhere {
    padding-top: var(--space-6);
  }
  .elsewhere h2 {
    margin: var(--space-1) 0 var(--space-4);
  }
  /* Three genuine peer groups: uniform columns */
  .social-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .social-group h3 {
    font-weight: 400;
    margin-bottom: var(--space-1);
  }
  .social-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 0.5px solid var(--hairline);
  }
  .social-group li {
    border-top: 0.5px solid var(--hairline);
  }
  .social-group a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: var(--space-2) 0;
    text-decoration: none;
  }
  .s-name {
    color: var(--ink);
  }
  .social-group a:hover .s-name {
    color: var(--accent);
  }
  @media (max-width: 860px) {
    .social-grid { grid-template-columns: 1fr; gap: var(--space-4); }
  }
  @media (max-width: 720px) {
    .info-strip {
      flex-direction: column;
    }
    .info-block {
      border-right: none;
      border-bottom: 0.5px solid var(--hairline);
      padding: var(--space-3) 0;
    }
    .info-block:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
    .info-block + .info-block {
      padding-left: 0;
    }
  }
</style>
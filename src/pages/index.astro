---
// Home: The Authority Engine for iGaming, in the terminal edition.
// One offer, told as a terminal session: health check -> diagnose ->
// method -> 90-day plan -> track record -> pricing -> FAQ -> audit form.
// Interactive bits (error picker, plan toggle) are progressive: with JS
// off, every error and both plans are still readable.
import { personSchema, businessSchema } from '../data/person';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { CONTACT } from '../config/site';

const base = import.meta.env.BASE_URL;
const url = 'https://bronson.co.za/';

// Seats and prices: the only numbers to edit when they change.
const SEATS_TOTAL = 6;
const SEATS_OPEN = 4;
const PRICE = { operator: 3500, affiliate: 1750 };
const usd = (n: number) => '$' + n.toLocaleString('en-US');
const seatsLine = SEATS_OPEN > 0 ? `${SEATS_OPEN}/${SEATS_TOTAL} seats open` : `${SEATS_TOTAL}/${SEATS_TOTAL} seats taken · waitlist open`;

const latestNotes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toISOString().slice(0, 10);

const inside = [
  { co: 'JazzSports', role: 'organic acquisition · 17 properties' },
  { co: 'Betcris', role: 'SEO manager' },
  { co: 'BetAnySports', role: 'SEO lead' },
  { co: 'WeezyBet', role: 'SEO team lead' },
];

const proofBar = [
  { k: '$20M+', v: 'yearly revenue from one organic system' },
  { k: '~75%', v: 'of that revenue from organic search' },
  { k: '+200%', v: 'organic traffic with AI-search work' },
  { k: '3 mo', v: 'to relaunch a failing sportsbook' },
];

const errors = [
  { code: 'E01', title: 'every search includes our brand name', cause: 'zero non-branded footprint after launch', fix: 'Build top-level casino, sports and promotions hubs and briefs for money terms, so new players find you before they find a review site.', layer: 'growth · days 31–60' },
  { code: 'E02', title: 'we pay CPA for searches we could own', cause: 'affiliates hold the market’s money terms', fix: 'Win the terms you can, and get listed by the affiliates that don’t cover you yet, using a research index they want to cite.', layer: 'domination · days 61–90+' },
  { code: 'E03', title: 'bonus pages search engines can’t read', cause: 'image banners, modal terms, duplicate ID URLs', fix: 'Evergreen promotion URLs by type, crawlable HTML terms, and a redirect map so relaunches stop wiping authority.', layer: 'foundations · days 1–30' },
  { code: 'E04', title: 'our provider ignores SEO tickets', cause: 'recommendations not written for the platform', fix: 'Platform-ready specs: routing, server rendering, taxonomy, redirects and schema, in a brief the provider can implement.', layer: 'foundations · days 1–30' },
  { code: 'E05', title: 'AI recommends the big books', cause: 'the web doesn’t vouch for you yet', fix: 'Close the verification gap: entity and licence data, reviews, affiliate listings and press that AI answers lean on.', layer: 'domination · days 61–90+' },
  { code: 'E06', title: 'we can’t tie SEO to FTDs or GGR', cause: 'tracking and reporting built on rankings', fix: 'Key events for registrations and deposits, plus a live dashboard joined to PAM data where available.', layer: 'foundations · days 1–30' },
];

const gap = [
  { n: '01', title: 'audit what you claim', body: 'architecture, promotions, schema, licence and entity data' },
  { n: '02', title: 'audit what the market confirms', body: 'affiliate listings, reviews, press, regulator lists, competitor links' },
  { n: '03', title: 'become the cited source', body: 'fix the platform, own the money pages, publish the index the market quotes' },
];

const phases = [
  { when: 'days 1–30 · foundations', name: 'Fix the leaks.', goal: 'Stop losing authority before spending on content.', dir: '/foundations', items: [['-rw-', 'crawl-index-canonical.audit'], ['-rw-', 'promotions-redirect.map'], ['-rwx', 'platform-brief.pdf'], ['-rwx', 'ftd-tracking.ga4']] },
  { when: 'days 31–60 · growth', name: 'Win non-branded.', goal: 'Casino, sports and bonus searches that bring new players.', dir: '/growth', items: [['drwx', 'casino-sports-promo-hubs/'], ['drwx', 'money-page-briefs/'], ['-rw-', 'affiliate-gap.csv'], ['-rw-', 'ai-citation-baseline.json']] },
  { when: 'days 61–90+ · domination', name: 'Get cited.', goal: 'Become the operator the market, and AI, vouches for.', dir: '/domination', items: [['drwx', 'market-research-index/'], ['-rwx', 'coverage-campaign.sh'], ['-rwx', 'signup-conversion.sh'], ['drwx', 'tournaments/']] },
];

const wins = [
  { k: '$20M+', v: 'annual revenue from an organic acquisition system across 17 sportsbook and casino properties.', who: 'jazzsports · 2019–2023' },
  { k: '+200%', v: 'organic traffic and 80% stronger engagement, with GEO/AEO for AI search.', who: 'betanysports · 2024' },
  { k: '20,000+', v: 'technical issues resolved across a 25,000-page network; organic acquisition doubled.', who: 'betcris · 2018–2019' },
  { k: '3 mo', v: 'to stabilise and relaunch a failing sportsbook platform.', who: 'weezybet · 2024–2025' },
];

const plans = [
  { id: 'operator', flag: '--type=operator', price: usd(PRICE.operator), who: 'For licensed sportsbooks and casinos, especially in their first two years.', items: ['platform-ready briefs and redirect maps', 'promotions, casino and sports architecture', 'quarterly market research index', 'affiliate gap analysis and listing outreach', 'live dashboard on sign-ups and GGR', 'monthly strategy session with your team'] },
  { id: 'affiliate', flag: '--type=affiliate', price: usd(PRICE.affiliate), who: 'For affiliates and review sites fighting for the same money terms.', items: ['money-page and comparison-page audit', 'content briefs built for AI citation', 'entity, author and trust-signal fixes', 'quarterly linkable data asset', 'live dashboard on clicks out and FTDs', 'monthly strategy call'] },
];

const faqs = [
  { q: 'We’re on a turnkey platform. Can SEO even work?', a: 'Yes. Most of my operator work has been on platforms with limits. The trick is specs the provider can implement. I’ve written those briefs for BetConstruct.' },
  { q: 'Won’t this compete with our affiliates?', a: 'It rebalances. Keep the affiliates that send real players, and stop depending on them for searches you should win. The research index also gets you listed by affiliates who don’t cover you yet.' },
  { q: 'How do you handle compliance and advertising rules?', a: 'Every brief respects your licence and market rules: responsible-gambling messaging, age gating, bonus terms in crawlable text. Your compliance team signs off before anything ships.' },
  { q: 'Which markets do you know?', a: 'South Africa, Latin America and international .com books, plus crypto-friendly operators. I’m based in Costa Rica.' },
  { q: 'What about AI search?', a: 'Players ask ChatGPT and Gemini which books to trust. Those answers lean on reviews, affiliates and press. Closing the verification gap moves rankings and AI recommendations together.' },
  { q: 'What happens after 90 days?', a: 'Month to month, or you leave with everything we built: briefs, assets and the dashboard.' },
];

const bar = (k: number) => '█'.repeat(k) + '░'.repeat(24 - k);
const meters = [
  { label: 'registrations', bar: bar(17), value: '412' },
  { label: 'ftds', bar: bar(12), value: '186' },
  { label: 'non-branded clicks', bar: bar(15), value: '9.8K' },
  { label: 'ai citations', bar: bar(7), value: '27' },
  { label: 'backlog shipped', bar: bar(16), value: '65%' },
];
---
<BaseLayout
  title="The Authority Engine: SEO for Sportsbooks and Casinos"
  description="SEO and AI-search growth for licensed sportsbooks, casinos and affiliates, from a strategist who worked inside them. Get a free operator audit."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      personSchema(),
      businessSchema(),
      {
        "@type": "WebSite",
        "@id": "https://bronson.co.za/#website",
        "url": "https://bronson.co.za",
        "name": "Bronson Harrington",
        "description": "The Authority Engine, field notes and builds from Bronson Harrington, growth architect",
        "publisher": { "@id": "https://bronson.co.za/#/schema/person" }
      },
      {
        "@type": "Service",
        "@id": `${url}#authority-engine`,
        "name": "The Authority Engine",
        "serviceType": "SEO and AI-search visibility for iGaming",
        "description": "Monthly SEO, authority and AI-search programme for licensed sportsbooks, casinos and affiliates, capped at six clients.",
        "provider": { "@id": "https://bronson.co.za/#/schema/person" },
        "areaServed": { "@type": "Place", "name": "Worldwide" },
        "audience": { "@type": "BusinessAudience", "name": "Licensed iGaming operators and affiliates" },
        "offers": plans.map((p) => ({
          "@type": "Offer",
          "name": `Authority Engine (${p.id})`,
          "description": p.who,
          "priceSpecification": { "@type": "UnitPriceSpecification", "price": PRICE[p.id as 'operator' | 'affiliate'], "priceCurrency": "USD", "unitText": "MONTH" }
        }))
      },
      {
        "@type": "FAQPage",
        "@id": `${url}#faq`,
        "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
      }
    ]
  })} />

  <!-- 01 · BOOT: the operator image is the page's one graphic; copy sits on its dark left side -->
  <section class="boot">
    <div class="hero-art" aria-hidden="true">
      <!-- 1.3s teleport-in, played once; the poster is its last frame, so
           reduced motion (or no autoplay) shows the operator standing -->
      <video class="teleport" muted playsinline preload="auto" width="760" height="1012"
        poster="/images/hero/teleport-poster.webp" tabindex="-1">
        <source src="/images/hero/teleport.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="container hero-copy">
      <p class="prompt">ops@your-sportsbook:~$ ./search-health --market za</p>
      <p class="status"><span class="fail">[FAIL]</span> non-branded search: 0 queries · <span class="warn">[warn]</span> money terms owned by affiliates</p>
      <h1>Don't gamble with your growth.<span class="cursor" aria-hidden="true">_</span></h1>
      <p class="lede">I've run SEO from inside sportsbooks and casinos. The Authority Engine wins the non-branded searches affiliates own today, in Google and AI answers, inside your platform and your licence.</p>
      <div class="ctas">
        <a href="#apply" class="btn solid">$ run free operator audit</a>
        <a href="#diagnose" class="btn">$ diagnose my errors</a>
      </div>
      <p class="fine">month 1 free if fewer than 10 revenue fixes found · no lock-in after 90 days · {seatsLine}</p>
    </div>
  </section>

  <!-- Who and what: worked-inside list and proof numbers, right under the hero -->
  <section class="creds" aria-label="Track record">
    <div class="container">
      <p class="inside"><span class="amber">$ whoami --history</span>
        {inside.map((r) => <span class="co"><strong>{r.co}</strong> <span class="soft">{r.role}</span></span>)}
      </p>
      <div class="proof-bar">
        {proofBar.map((p) => <div><span class="big">{p.k}</span><span class="soft">{p.v}</span></div>)}
      </div>
    </div>
  </section>

  <!-- 02 · DIAGNOSE -->
  <section class="sec-band" id="diagnose">
    <div class="container">
      <p class="tag">~/diagnose · select the error your book is throwing</p>
      <h2>Affiliates own your market's searches. You pay them for it.</h2>
      <div class="split">
        <div class="pick-list" role="group" aria-label="Common errors">
          {errors.map((e, i) => (
            <button type="button" class="pick" data-code={e.code} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="diagnosis">
              <span class="amber">{e.code}</span> {e.title}
            </button>
          ))}
        </div>
        <div class="panel out" id="diagnosis" aria-live="polite">
          {errors.map((e, i) => (
            <div class="diag" data-for={e.code} hidden={i !== 0}>
              <p class="soft">$ diagnose --error {e.code}</p>
              <p class="amber">cause: {e.cause}</p>
              <p>{e.fix}</p>
              <p class="green">→ patched in: {e.layer}</p>
            </div>
          ))}
          <a href="#plan" class="go">$ cat ./90-day-plan<span class="cursor" aria-hidden="true">_</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 · METHOD -->
  <section class="sec-band alt">
    <div class="container split center">
      <div>
        <p class="tag">$ man authority-verification-gap</p>
        <h2>Become the source the market cites.</h2>
        <p class="soft">Google and AI assistants trust the operators the web vouches for: reviews, affiliates, press, regulator lists. Buying links doesn't change that. Closing the gap between what you claim and what the market confirms does.</p>
      </div>
      <ol class="panel listing">
        {gap.map((g) => <li><span class="amber">{g.n}</span><span><strong>{g.title}</strong><span class="soft">{g.body}</span></span></li>)}
      </ol>
    </div>
  </section>

  <!-- 04 · 90-DAY PLAN -->
  <section class="sec-band" id="plan">
    <div class="container">
      <p class="tag">$ cat ./90-day-plan</p>
      <h2>Built for turnkey platforms.</h2>
      <p class="soft intro">Locked on BetConstruct or another provider? Normal. I write the briefs, redirect maps and specs the provider needs, so changes actually ship.</p>
      {phases.map((l) => (
        <div class="phase split">
          <div>
            <p class="amber">{l.when}</p>
            <h3>{l.name}</h3>
            <p class="soft">{l.goal}</p>
          </div>
          <div class="panel listing">
            <p class="soft">$ ls -la {l.dir}</p>
            <ul>{l.items.map(([perm, name]) => <li><span class="perm">{perm}</span><span>{name}</span></li>)}</ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 05 · TRACK RECORD -->
  <section class="sec-band alt" id="logs">
    <div class="container">
      <p class="tag">$ tail /var/log/operators.log</p>
      <h2>Production logs from inside the industry.</h2>
      <div class="wins">
        {wins.map((w) => <div class="panel win"><span class="big">{w.k}</span><span class="soft">{w.v}</span><span class="amber small">{w.who}</span></div>)}
      </div>
      <div class="panel live">
        <p class="amber">$ tail -f live/za-operator.log</p>
        <pre>wk1  search console: 100% branded queries · 0 non-branded
wk2  51 duplicate promotion URLs found · no crawlable text
wk2  promotions page: 109K impressions · 3.7% CTR
wk3  13-page platform brief + redirect map → provider
next quarterly za betting &amp; casino research index</pre>
      </div>
    </div>
  </section>

  <!-- 06 · PRICING -->
  <section class="sec-band" id="pricing">
    <div class="container">
      <p class="tag">$ authority-engine install --type</p>
      <h2>Two engines. {SEATS_TOTAL} seats total.</h2>
      <p class="soft intro">One senior strategist, no juniors, no account managers. When the seats are full there's a waitlist.</p>
      <div class="tabs" role="tablist" aria-label="Choose your business type">
        {plans.map((p, i) => (
          <button type="button" role="tab" id={`tab-${p.id}`} aria-controls={`plan-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} class="tab" data-plan={p.id}>--{p.id}</button>
        ))}
      </div>
      <div class="split">
        <div>
          {plans.map((p) => (
            <article class="panel plan" id={`plan-${p.id}`} role="tabpanel" aria-labelledby={`tab-${p.id}`} data-panel={p.id}>
              <p class="soft">{p.flag}</p>
              <p class="price"><span class="big amber">{p.price}</span><span class="soft">/mo</span></p>
              <p class="soft">{p.who}</p>
              <ul>{p.items.map((i) => <li>+ {i}</li>)}</ul>
              <a href="#apply" class="btn solid">$ apply · {SEATS_OPEN} seats open</a>
            </article>
          ))}
        </div>
        <aside class="panel guarantee">
          <p class="amber">$ cat guarantee.txt</p>
          <p>If month one doesn't uncover at least 10 fixes that affect sign-ups or GGR, month one is free.</p>
          <p>After 90 days: month to month. Every brief, asset and dashboard stays with you.</p>
          <p class="faint">Never a ranking or link-count guarantee. Nobody honest offers one.</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- 07 · DASHBOARD -->
  <section class="sec-band alt">
    <div class="container split center">
      <div>
        <p class="tag">$ top --operator yours</p>
        <h2>Players, not rankings.</h2>
        <p class="soft">One live dashboard tied to registrations, FTDs and GGR, plus the backlog, so your team sees every task.</p>
      </div>
      <figure class="panel meters" aria-label="Example operator dashboard with sample numbers">
        <figcaption class="soft"><span>your-brand · 30d</span><span>sample data</span></figcaption>
        {meters.map((m) => <div class="meter"><span class="soft">{m.label}</span><span class="green bars" aria-hidden="true">{m.bar}</span><span class="amber">{m.value}</span></div>)}
        <p class="faint small">sources: search console · ga4 · ai visibility · crm/pam · backlog</p>
      </figure>
    </div>
  </section>

  <!-- 08 · FAQ -->
  <section class="sec-band" id="faq">
    <div class="container narrow">
      <p class="tag">$ faq --operators</p>
      <h2>Operator questions.</h2>
      <div class="faqs">
        {faqs.map((f, i) => (
          <details class="panel" open={i === 0}>
            <summary>&gt; {f.q}</summary>
            <p class="soft">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 09 · APPLY -->
  <section class="sec-band alt" id="apply">
    <div class="container split">
      <div>
        <p class="tag">$ sudo request-audit</p>
        <h2 class="huge">Ready to deploy?<span class="cursor" aria-hidden="true">_</span></h2>
        <p class="soft">Within three business days: a short video with your branded vs non-branded split, which affiliates outrank you in your own market, the three biggest platform-level gaps, and what I'd patch first.</p>
        <p class="soft">Include your site and licensed market in the message. B2B only: licensed operators, affiliates and platforms. NDA on request.</p>
        <p class="soft">Or email <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> · {seatsLine}</p>
      </div>
      <div class="panel">
        <ContactForm variant="full" location="home" />
      </div>
    </div>
  </section>

  <!-- 10 · ALSO HERE: the rest of the site -->
  <section class="sec-band" aria-labelledby="also-title">
    <div class="container">
      <p class="tag">$ ls ~/bronson</p>
      <h2 id="also-title">Also on this machine.</h2>
      <ul class="also">
        <li><a href={`${base}notes/`}>notes/</a><span class="soft">field notes on SEO, AEO and growth systems</span></li>
        <li><a href={`${base}lab/`}>lab/</a><span class="soft">tools and builds</span></li>
        <li><a href={`${base}framework/`}>growth-os/</a><span class="soft">the framework behind the engine</span></li>
        <li><a href={`${base}work-with-me/`}>work-with-me/</a><span class="soft">in-house roles, fractional work and advisory</span></li>
      </ul>
      <ol class="notes">
        {latestNotes.map((n) => <li><time class="faint" datetime={fmt(n.data.date)}>{fmt(n.data.date)}</time><a href={`${base}notes/${n.slug}/`}>{n.data.title}</a></li>)}
      </ol>
    </div>
  </section>
</BaseLayout>

<script>
  // Hero: the operator teleports in once. With reduced motion the poster
  // (the clip's last frame) stays, so he's simply standing there.
  const tp = document.querySelector<HTMLVideoElement>('.teleport');
  if (tp && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    tp.play().catch(() => { /* autoplay refused: the poster stands in */ });
  }

  // Error picker: show one diagnosis at a time
  const picks = document.querySelectorAll<HTMLButtonElement>('.pick');
  const diags = document.querySelectorAll<HTMLElement>('.diag');
  picks.forEach((b) => b.addEventListener('click', () => {
    picks.forEach((p) => p.setAttribute('aria-pressed', String(p === b)));
    diags.forEach((d) => { d.hidden = d.dataset.for !== b.dataset.code; });
  }));

  // Plan toggle: operator / affiliate. Without JS both plans stay visible.
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  const show = (id: string) => {
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.plan === id)));
    panels.forEach((p) => { p.hidden = p.dataset.panel !== id; });
  };
  tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.plan!)));
  if (tabs.length) show(tabs[0].dataset.plan!);
</script>

<style>
  [hidden] { display: none !important; }
  .amber { color: var(--accent); }
  .green { color: var(--ink); }
  .soft { color: var(--ink-soft); }
  .faint { color: var(--ink-faint); }
  .small { font-size: var(--text-xs); }
  .tag { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--ink-faint); margin: 0 0 var(--space-2); }
  .big { font-family: var(--font-display); font-size: 3rem; line-height: 0.9; color: var(--ink); }
  .narrow { max-width: var(--content-narrow); }

  .panel {
    background: var(--paper-dim);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: var(--space-4);
  }
  .panel p:last-child { margin-bottom: 0; }

  .btn {
    display: inline-flex; align-items: center; min-height: 52px; padding: 0 var(--space-3);
    border: 2px solid var(--rule-strong); border-radius: var(--radius);
    color: var(--ink-soft); text-decoration: none; font-family: var(--font-mono); font-weight: 700;
  }
  .btn.solid { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .btn:hover { background: var(--accent); border-color: var(--accent); color: var(--paper); }

  .cursor { animation: blink 1s step-end infinite; color: var(--ink); }
  @keyframes blink { 50% { opacity: 0; } }

  /* Boot / hero */
  .boot { position: relative; overflow: hidden; min-height: max(580px, 33.4vw); display: flex; align-items: center; border-bottom: 1px solid var(--hairline); }
  /* Operator teleports in on the right. The clip is on black, so screen
     blending drops the black and keeps only the light; a radial mask
     dissolves the clip's edges into the page. */
  .hero-art {
    position: absolute; bottom: 0; top: 0;
    right: max(var(--space-3), calc((100vw - var(--content-width)) / 2 - 3rem));
    display: flex; align-items: flex-end; pointer-events: none;
  }
  .teleport {
    display: block; height: 100%; max-height: 760px; width: auto;
    mix-blend-mode: screen;
    -webkit-mask-image: radial-gradient(ellipse 50% 52% at 50% 50%, #000 62%, transparent 100%);
    mask-image: radial-gradient(ellipse 50% 52% at 50% 50%, #000 62%, transparent 100%);
  }
  .hero-copy { position: relative; width: 100%; padding-top: var(--space-5); padding-bottom: var(--space-5); }
  .hero-copy > * { max-width: 500px; }
  .hero-copy > .ctas { max-width: 640px; }
  .hero-copy h1 { font-size: 3.6rem; }
  .prompt { font-size: var(--text-sm); color: var(--ink-faint); margin: 0 0 var(--space-1); }
  .status { font-size: var(--text-xs); color: var(--ink-soft); margin: 0 0 var(--space-2); }
  .status .fail { color: var(--danger); }
  .status .warn { color: var(--accent); }
  .hero-copy h1 { margin-bottom: var(--space-3); }
  .lede { font-size: var(--text-base); line-height: 1.7; color: var(--ink-soft); }
  .hero-copy .lede { margin-bottom: var(--space-3); }
  .ctas { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-2); }
  .fine { font-size: var(--text-xs); color: var(--ink-faint); margin: 0; }

  .creds { padding: var(--space-4) 0 var(--space-3); border-bottom: 1px solid var(--hairline); }

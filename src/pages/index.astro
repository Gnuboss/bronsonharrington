---
import { personSchema, businessSchema } from '../data/person';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { phases } from '../data/framework';
import { projects } from '../data/projects';
import { profileUrls } from '../data/socials';
import { CONTACT } from '../config/site';

const base = import.meta.env.BASE_URL;
const latestNotes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 10); // home page shows the 10 most recent; the rest live on /notes/
const fmt = (d: Date) => d.toISOString().slice(0, 10);

const testimonials = [
  {
    quote: "I genuinely enjoyed the experience. He's incredibly sharp, always positive, and brings a level of strategic thinking that goes well beyond day-to-day execution. Bronson is constantly thinking long-term and building strategies that actually last, not just quick wins.",
    name: 'Tarsis Tochi', role: 'Performance Marketing Manager', company: 'Disability Law Marketing LLC, Canada',
  },
  {
    quote: "Nothing was impossible for Mr Harrington, merely challenges to overcome. He also was exceptionally well liked which meant that he could get the best out of others where others failed. Never a moment without a smile and a total 'can do' attitude.",
    name: 'Richard De Waal', role: 'Founder', company: 'Tiburon Media, Africa',
  },
  {
    quote: "Bronson was an outstanding director while at Downtown Ecommerce. He brought great value, creativity, and insights to our organization, and specifically with link building for topical authority. Any team that has Bronson on their staff is a force to reckon with.",
    name: 'Patrick Tigue', role: 'Founder', company: 'Downtown eCommerce Partners, USA',
  },
];
---
<BaseLayout
  title="Bronson Harrington | Growth Architect in Costa Rica"
  description="Bronson Harrington, growth architect in Costa Rica. Notes on SEO, AEO and growth systems, plus the tools he builds. Read the latest notes."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      personSchema(),
      businessSchema(),
      {
        "@type": "WebSite",
        "@id": "https://bronson.co.za/#website",
        "url": "https://bronson.co.za",
        "name": "Bronson Harrington",
        "description": "Notes, builds and the Growth OS framework from Bronson Harrington",
        "publisher": { "@id": "https://bronson.co.za/#/schema/person" }
      }
    ]
  })} />

  <PageHero eyebrow="~/bronson/costa-rica" title="Bronson Harrington" subtitle="Growth Architect · SEO / AEO · builder">
    <p class="lede">I've spent 25 years building organic growth systems inside iGaming, fintech and other regulated markets. This is where I write about that work, think out loud about systems and digital sovereignty, and keep the tools I build on the side. <a href={`${base}about-me/`}>More about me →</a></p>
  </PageHero>

  <hr class="hairline" />

  <!-- Field notes: a dated sequence, so rows with the date in the margin column -->
  <Section eyebrow="~/field-notes" title="Field Notes." more={{ href: `${base}notes/`, label: 'all field notes' }}>
    <ol class="rows">
      {latestNotes.map((note) => (
        <li>
          <a href={`${base}notes/${note.slug}/`} class="row hang">
            <time class="hang-label" datetime={fmt(note.data.date)}>{fmt(note.data.date)}</time>
            <div class="hang-body">
              <h3>{note.data.title}</h3>
              <p>{note.data.description}</p>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </Section>

  <hr class="hairline" />

  <!-- Builds: genuine peers, one uniform row -->
  <Section eyebrow="~/lab" title="Things I've Built." more={{ href: `${base}lab/`, label: 'the lab' }}>
    <div class="g">
      {projects.map((p) => (
        <article class="card s-3">
          <p class="label">{p.stack}</p>
          <h3>{p.name}</h3>
          <p>{p.summary}</p>
          <a href={p.href} class="more">{p.linkLabel} →</a>
        </article>
      ))}
    </div>
  </Section>

  <hr class="hairline" />

  <!-- Growth OS: a real sequence, so the staircase -->
  <Section
    eyebrow="~/framework"
    title="How I Think About Growth."
    intro="Growth OS is the model I've refined over 25 years: organic growth moves through three stages, each built on the one before it."
    more={{ href: `${base}framework/`, label: 'read the framework' }}
  >
    <div class="g stair">
      {phases.map((p) => (
        <a href={`${base}framework/#${p.id}`} class="card step">
          <p class="label">{p.num} · {p.name.toLowerCase()}</p>
          <h3>{p.headline}</h3>
        </a>
      ))}
    </div>
  </Section>

  <hr class="hairline" />

  <!-- Testimonials: peers, natural height (the quotes differ in length) -->
  <Section eyebrow="~/colleagues" title="What People I've Worked With Say.">
    <div class="g">
      {testimonials.map((t) => (
        <blockquote class="card s-4 quote">
          <p>"{t.quote}"</p>
          <footer>
            <span class="name">{t.name}</span>
            <span class="label">{t.role}</span>
            <span class="label">{t.company}</span>
          </footer>
        </blockquote>
      ))}
    </div>
  </Section>
</BaseLayout>

<style>
  .lede a {
    color: var(--accent);
  }
  .step {
    text-decoration: none;
  }
  .step h3 {
    font-size: var(--text-lg);
  }
  .step:hover h3 {
    color: var(--accent);
  }
  .quote {
    margin: 0;
  }
  .quote > p {
    margin: 0;
    font-size: var(--text-base);
    color: var(--ink);
    line-height: 1.5;
  }
  .quote footer {
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .quote .name {
    color: var(--ink);
    font-weight: 500;
  }
  @media (min-width: 720px) and (max-width: 979px) {
    .quote.s-4 { grid-column: span 8; }
  }
</style>

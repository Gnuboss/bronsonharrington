---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhaseNav from '../components/PhaseNav.astro';
import { projects } from '../data/projects';

const base = import.meta.env.BASE_URL;
const latestNotes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<BaseLayout
  title="Bronson Harrington | Growth Architect in Costa Rica"
  description="Bronson Harrington, growth architect in Costa Rica. Notes on SEO, AEO and growth systems, plus the tools he builds. Read the latest notes."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://bronson.co.za/#/schema/person",
        "name": "Bronson Harrington",
        "description": "Growth Architect with 25 years of experience building organic growth systems in iGaming, fintech and other regulated markets.",
        "jobTitle": "Growth Architect",
        "url": "https://bronson.co.za",
        "homeLocation": { "@type": "Place", "name": "San José, Costa Rica" },
        "knowsAbout": [
          "Search Engine Optimization",
          "Answer Engine Optimization",
          "Technical SEO",
          "Topical Authority",
          "Regulated Market SEO",
          "Growth Strategy"
        ],
        "sameAs": [
          "https://www.linkedin.com/in/bronsonharrington/",
          "https://www.facebook.com/BronsonHarrington",
          "https://www.instagram.com/bronson.harrington/",
          "https://github.com/Gnuboss"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://bronson.co.za/#website",
        "url": "https://bronson.co.za",
        "name": "Bronson Harrington",
        "description": "Notes, builds and the Growth OS framework from Bronson Harrington",
        "publisher": { "@id": "https://bronson.co.za/#/schema/person" }
      }
    ]
  })} />

  <section class="hero container">
    <p class="eyebrow">~/bronson/costa-rica</p>
    <div class="hero-grid">
      <div class="hero-rule" aria-hidden="true"></div>
      <div>
        <h1>Bronson Harrington</h1>
        <p class="label subtitle">Growth Architect · SEO / AEO · builder</p>
        <p class="lede">I've spent 25 years building organic growth systems inside iGaming, fintech and other regulated markets. This is where I write about that work, think out loud about systems and digital sovereignty, and keep the tools I build on the side.</p>
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <section class="notes container">
    <div class="section-head">
      <div>
        <p class="eyebrow">~/notes</p>
        <h2>Latest Notes.</h2>
      </div>
      <a href={`${base}notes/`} class="more">all notes →</a>
    </div>
    <ol class="note-list">
      {latestNotes.map((note) => (
        <li>
          <time class="label" datetime={fmt(note.data.date)}>{fmt(note.data.date)}</time>
          <div>
            <h3><a href={`${base}notes/${note.slug}/`}>{note.data.title}</a></h3>
            <p>{note.data.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <hr class="hairline" />

  <section class="builds container">
    <div class="section-head">
      <div>
        <p class="eyebrow">~/lab</p>
        <h2>Things I've Built.</h2>
      </div>
      <a href="https://github.com/Gnuboss" class="more">github →</a>
    </div>
    <div class="build-grid">
      {projects.map((p) => (
        <article class="build-card">
          <h3>{p.name}</h3>
          <p class="label">{p.stack}</p>
          <p class="summary">{p.summary}</p>
          <a href={p.href} class="build-link">{p.linkLabel} →</a>
        </article>
      ))}
    </div>
  </section>

  <hr class="hairline" />

  <section class="framework container">
    <p class="eyebrow">~/framework</p>
    <h2>How I Think About Growth.</h2>
    <p class="lede">Growth OS is the model I've refined over 25 years: organic growth moves through three stages, Foundations, Growth and Domination, each built on the one before it.</p>
    <PhaseNav />
    <a href={`${base}framework/`} class="more">read the framework →</a>
  </section>

  <hr class="hairline" />

  <section class="testimonials container">
    <p class="eyebrow">~/colleagues</p>
    <h2>What People I've Worked With Say.</h2>
    <div class="testimonial-grid">
      <blockquote class="testimonial">
        <p>"I genuinely enjoyed the experience. He's incredibly sharp, always positive, and brings a level of strategic thinking that goes well beyond day-to-day execution. Bronson is constantly thinking long-term and building strategies that actually last, not just quick wins."</p>
        <footer>
          <span class="name">Tarsis Tochi</span>
          <span class="label">Performance Marketing Manager</span>
        </footer>
      </blockquote>
      <blockquote class="testimonial">
        <p>"Nothing was impossible for Mr Harrington, merely challenges to overcome. He also was exceptionally well liked which meant that he could get the best out of others where others failed. Never a moment without a smile and a total 'can do' attitude."</p>
        <footer>
          <span class="name">Richard De Waal</span>
          <span class="label">Founder</span>
        </footer>
      </blockquote>
      <blockquote class="testimonial">
        <p>"Bronson was an outstanding director while at Downtown Ecommerce. He brought great value, creativity, and insights to our organization, and specifically with link building for topical authority. Any team that has Bronson on their staff is a force to reckon with."</p>
        <footer>
          <span class="name">Patrick Tigue</span>
          <span class="label">Founder</span>
        </footer>
      </blockquote>
    </div>
  </section>

  <hr class="hairline" />

  <section class="contact container">
    <h2>Say Hello.</h2>
    <p>Want to compare notes, talk about a build, or ask about something I've written? <a href={`${base}contact/`}>Get in touch</a>.</p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1px 1fr;
    gap: var(--space-5);
    margin-top: var(--space-3);
  }
  .hero-rule {
    background: var(--hairline);
  }
  .subtitle {
    margin: var(--space-2) 0 var(--space-3);
  }
  .lede {
    font-size: var(--text-lg);
    color: var(--ink-soft);
    max-width: var(--content-narrow);
  }

  .notes,
  .builds,
  .framework,
  .testimonials {
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .section-head h2 {
    margin-top: var(--space-1);
  }
  .framework h2,
  .testimonials h2 {
    margin: var(--space-1) 0 var(--space-3);
  }
  .more {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .framework .more {
    display: inline-block;
    margin-top: var(--space-3);
  }

  /* Notes: a dated sequence, so a list rather than cards */
  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .note-list li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 0.5px solid var(--hairline);
  }
  .note-list time {
    padding-top: 0.4rem;
  }
  .note-list h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }
  .note-list h3 a {
    text-decoration: none;
  }
  .note-list h3 a:hover {
    color: var(--accent);
  }
  .note-list p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  /* Builds: genuine peers, so a uniform grid */
  .build-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }
  .build-card {
    border-top: 2px solid var(--ink);
    padding-top: var(--space-3);
    display: flex;
    flex-direction: column;
  }
  .build-card h3 {
    font-size: var(--text-lg);
  }
  .build-card .label {
    margin: var(--space-1) 0 var(--space-2);
  }
  .build-card .summary {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .build-link {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    text-decoration: none;
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .testimonial {
    margin: 0;
    padding-top: var(--space-3);
    border-top: 2px solid var(--ink);
  }
  .testimonial p {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    font-style: italic;
  }
  .testimonial footer {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-2);
  }
  .testimonial .name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .contact {
    padding-top: var(--space-6);
  }
  .contact h2 {
    margin-bottom: var(--space-2);
  }
  .contact a {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-rule { display: none; }
    .build-grid { grid-template-columns: 1fr; }
    .testimonial-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .note-list li {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>

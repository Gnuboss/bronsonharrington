---
// Category-definition page for "Growth Architect, Costa Rica".
//
// Why it exists (STANDARDS.md, SEO/AEO): it defines the term in plain,
// quotable answers so Google and AI answer engines can attach it to
// Bronson. Answers are visible on the page, not collapsed, because answer
// engines quote what they can read, and the FAQPage schema is generated
// from the same array so the markup always matches the text. Linked from
// the footer on every page.
//
// Reframed in Nov 2026 from the original iGaming page: the definition is
// vertical-agnostic, and iGaming is the proof, not the niche. No sales CTA,
// in line with the personal-site positioning.
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { personSchema, businessSchema, PERSON_ID, PERSON } from '../data/person';
import { faqs, DOC, PAGE_URL as url, PDF_FILE, PDF_URL } from '../data/growth-architect';

const base = import.meta.env.BASE_URL;
const pdf = `${base}downloads/${PDF_FILE}`;
const pdfKb = 211; // update if the PDF changes size noticeably

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${url}#faq`,
  url,
  name: PERSON.descriptor,
  about: { '@id': PERSON_ID },
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Defines the term itself, and ties it to the person who holds the title
const termSchema = {
  '@type': 'DefinedTerm',
  '@id': `${url}#term`,
  name: 'Growth Architect',
  description: faqs[0].a,
  url,
  inDefinedTermSet: { '@type': 'DefinedTermSet', name: 'Growth OS', url: 'https://bronson.co.za/framework/' },
  subjectOf: [{ '@id': `${url}#faq` }, { '@id': `${PDF_URL}#document` }],
};

// The downloadable PDF, so search and AI tools know who wrote it and
// that this page is its canonical web version
const docSchema = {
  '@type': 'DigitalDocument',
  '@id': `${PDF_URL}#document`,
  name: DOC.title,
  description: DOC.subject,
  url: PDF_URL,
  encodingFormat: 'application/pdf',
  inLanguage: 'en',
  version: DOC.version,
  datePublished: DOC.date,
  dateModified: DOC.date,
  keywords: DOC.keywords.join(', '),
  author: { '@id': PERSON_ID },
  publisher: { '@id': PERSON_ID },
  about: { '@id': `${url}#term` },
  mainEntityOfPage: url,
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [faqSchema, termSchema, docSchema, personSchema(), businessSchema()],
};
---
<BaseLayout
  title="Growth Architect Costa Rica | Bronson Harrington"
  description="What a Growth Architect is, how it differs from SEO consulting, and the results behind Bronson Harrington's work from Costa Rica. Quick answers inside."
>
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />

  <PageHero eyebrow="~/growth-architect/costa-rica" title="Growth Architect, Costa Rica">
    <p class="lede">A Growth Architect designs the system organic growth runs on: the technical foundation, the authority a site builds, and how it's found across search and AI answer engines. Bronson Harrington does this work from San José, Costa Rica.</p>
  </PageHero>

  <hr class="hairline" />

  <!-- Answers visible, not collapsed: answer engines quote what they can read -->
  <Section eyebrow="quick answers" title="The short version.">
    <div class="rows">
      {faqs.map((f) => (
        <div class="hang">
          <h3 class="hang-label q">{f.q}</h3>
          <p class="hang-body">{f.a}</p>
        </div>
      ))}
    </div>
    <div class="hang see-also">
      <p class="hang-label tag">see also</p>
      <p class="hang-body">The full model: <a href={`${base}framework/`}>Growth OS</a>. The longer story: <a href={`${base}about-me/`}>about me</a>.</p>
    </div>
  </Section>

  <hr class="hairline" />

  <Section eyebrow="worked example" title="White-label iGaming, without a rebuild.">
    <p slot="intro" class="lede">White-label iGaming platforms show the idea clearly. Their pages are rendered in the browser with JavaScript, so search crawlers and AI agents often see very little, and heavy browsing traffic competes with transactions for the same database.</p>
    <div class="hang">
      <div class="hang-body prose">
        <p>The fix is architectural, not editorial. A server-side pre-rendered layer turns game lobbies and live odds into flat HTML served from edge caches, which crawlers and AI retrieval systems can read instantly. Edge caching and asynchronous event streams take the browsing load off the transaction database. It all deploys through DNS and CDN routing, with no change to the underlying platform or its compliance certificates.</p>
        <p>The longer write-up is in the field note <a href={`${base}notes/growth-architecture-for-white-label-igaming/`}>Growth architecture for white-label iGaming stacks</a>.</p>
        <a href={pdf} class="pdf" download>
          <span class="label">PDF · 5 pages · {pdfKb} KB · version {DOC.version}</span>
          <span class="pdf-title">{DOC.title}</span>
          <span class="more">download →</span>
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .q {
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--ink);
    padding-top: 0;
  }
  .rows .hang-body {
    margin: 0;
    color: var(--ink-soft);
  }
  .see-also {
    margin-top: var(--space-4);
  }
  .see-also .hang-body {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .see-also a {
    color: var(--accent);
  }
  .pdf {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: var(--space-4);
    padding: var(--space-3);
    border: 0.5px solid var(--hairline);
    border-top: 2px solid var(--rule-strong);
    text-decoration: none;
  }
  .pdf-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--ink);
  }
  .pdf .more {
    margin-top: var(--space-1);
  }
  .pdf:hover .pdf-title {
    color: var(--accent);
  }
</style>

---
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects, experiments } from '../data/projects';
---
<BaseLayout
  title="Lab: Local-First Tools and Experiments | Bronson Harrington"
  description="Small, local-first tools and experiments built by Bronson Harrington, from a job tracker to an invoicing app. Open one up and try it."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Lab - Bronson Harrington",
    "url": "https://bronson.co.za/lab/",
    "author": { "@id": "https://bronson.co.za/#/schema/person" },
    "hasPart": [...projects, ...experiments].map((p) => ({
      "@type": "SoftwareApplication",
      "name": p.name,
      "description": p.summary,
      "url": p.href.startsWith("/") ? `https://bronson.co.za${p.href}` : p.href,
      "applicationCategory": "WebApplication"
    }))
  })} />

  <PageHero eyebrow="~/lab" title="Lab">
    <p class="lede">Things I build on the side. Mostly small, mostly local-first, usually started because something I needed didn't exist or didn't work the way it should.</p>
  </PageHero>

  <hr class="hairline" />

  <!-- Projects are peers: a uniform 2 x 6 grid with room for the summaries -->
  <Section eyebrow="~/builds" title="Projects" hiddenTitle>
    <div class="g">
      {projects.map((p) => (
        <article class="card s-6">
          <p class="label">{p.stack}</p>
          <h3>{p.name}</h3>
          <p>{p.summary}</p>
          <a href={p.href} class="more">{p.linkLabel} →</a>
        </article>
      ))}
    </div>
    <div class="hang more-note">
      <p class="hang-label tag">more</p>
      <p class="hang-body">More experiments live on <a href="https://github.com/Gnuboss">GitHub</a>.</p>
    </div>
  </Section>

  <hr class="hairline" />

  <Section eyebrow="~/experiments" title="Experiments." intro="Ideas tried out on this site itself. Each one comes with a field note on how it was built and what I learned.">
    <div class="g">
      {experiments.map((p) => (
        <article class="card s-6">
          <p class="label">{p.stack}</p>
          <h3>{p.name}</h3>
          <p>{p.summary}</p>
          <div class="links">
            <a href={p.href} class="more">{p.linkLabel} →</a>
            {p.note && <a href={p.note} class="more">read the field note →</a>}
          </div>
        </article>
      ))}
    </div>
  </Section>
</BaseLayout>

<style>
  .card h3 {
    font-size: var(--text-xl);
  }
  @media (min-width: 720px) and (max-width: 979px) {
    .card.s-6 { grid-column: span 4; }
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }
  .links .more {
    margin: 0;
  }
  .more-note {
    margin-top: var(--space-5);
  }
  .more-note .hang-body {
    margin: 0;
    color: var(--ink-muted);
  }
  .more-note a {
    color: var(--accent);
  }
</style>

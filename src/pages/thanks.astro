---
// Thank-you page for every contact form. Each form lands here with its own
// ?src= (footer, contact), so GA4 can count conversions per form from the
// page_view alone. Not indexed and not in the sitemap.
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT } from '../config/site';
import { RESPONSE_PROMISE } from '../data/contact';

const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Message received | Bronson Harrington"
  description="Your message to Bronson Harrington arrived. Here's what happens next, and how to reach him directly if it's urgent."
>
  <meta slot="head" name="robots" content="noindex, follow" />

  <PageHero eyebrow="~/message-received" title="Got it. Thanks for writing.">
    <p class="lede">Your message is in my inbox. I'll reply to the email address you gave.</p>
  </PageHero>

  <hr class="hairline" />

  <Section eyebrow="~/next" title="What happens next.">
    <ol class="rows">
      <li class="hang"><span class="hang-label">01</span><p class="hang-body">I read it, usually the same day.</p></li>
      <li class="hang"><span class="hang-label">02</span><p class="hang-body">I reply by email. {RESPONSE_PROMISE.split('·')[1]?.trim()}.</p></li>
      <li class="hang"><span class="hang-label">03</span><p class="hang-body">If you don't hear back in a week, check your spam folder, then email me directly.</p></li>
    </ol>
    <div class="hang direct">
      <p class="hang-label tag">sooner?</p>
      <p class="hang-body">Email <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> or call <a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a>. Or <a href={`${base}notes/`}>read the field notes</a> while you wait.</p>
    </div>
  </Section>
</BaseLayout>

<style>
  .rows .hang-body {
    margin: 0;
    color: var(--ink);
  }
  .direct {
    margin-top: var(--space-4);
  }
  .direct .hang-body {
    margin: 0;
    color: var(--ink-muted);
  }
  .direct a {
    color: var(--accent);
  }
</style>

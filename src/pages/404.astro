---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Page Not Found | Bronson Harrington" description="This page doesn't exist, or it moved when the site was rebuilt. Try the field notes, the lab or the home page instead.">
  <meta name="robots" content="noindex" slot="head" />

  <PageHero eyebrow="~/404" title="Page not found.">
    <p class="lede">This page doesn't exist, or it moved when the site was rebuilt. Some older service pages were retired along the way.</p>
    <ul class="paths">
      <li><a href={base}>~/home</a></li>
      <li><a href={`${base}notes/`}>~/field-notes</a></li>
      <li><a href={`${base}lab/`}>~/lab</a></li>
      <li><a href={`${base}framework/`}>~/framework</a></li>
    </ul>
  </PageHero>
</BaseLayout>

<style>
  .paths {
    list-style: none;
    margin: var(--space-4) 0 var(--space-6);
    padding: 0;
    border-top: 2px solid var(--rule-strong);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .paths li {
    border-bottom: 0.5px solid var(--hairline);
  }
  .paths a {
    display: block;
    padding: var(--space-2) 0;
    color: var(--ink);
    text-decoration: none;
  }
  .paths a:hover {
    color: var(--accent);
  }
</style>

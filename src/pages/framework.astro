---
import BaseLayout from '../layouts/BaseLayout.astro';
import { phases } from '../data/framework';
import { faqs as gaFaqs } from '../data/growth-architect';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';

const base = import.meta.env.BASE_URL;

const faqs = [
  // Same definition as the Growth Architect page, so the term has one meaning everywhere
  { q: gaFaqs[0].q, a: gaFaqs[0].a },
  {
    q: 'Do you have to start with Foundations?',
    a: "Not always. Plenty of sites already have solid technical health and can move straight into Growth. But it's worth checking first: content and links built on a broken foundation produce a fraction of the results they should, and the problem is rarely visible from the surface.",
  },
  {
    q: 'Is Growth OS only for regulated industries?',
    a: "No. It was shaped in iGaming, fintech and other regulated verticals, where the bar for trust is highest and the cost of shortcuts is most visible. The principles are the same for any site, whatever its size: strong foundations, useful content, consistent optimisation and authority that's earned.",
  },
  {
    q: 'How does AI search change the framework?',
    a: "It raises the stakes on the same principles. Answer engines can only cite what they can crawl, parse and trust, so clean HTML, clear entities and genuine topical depth matter more, not less. The goal in Domination has shifted from being ranked to being recommended.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Growth OS: an organic growth framework",
      "description": "A three-stage model for sustainable organic growth: Foundations, Growth and Domination.",
      "url": "https://bronson.co.za/framework/",
      "author": { "@id": "https://bronson.co.za/#/schema/person" },
      "about": ["Search Engine Optimization", "Answer Engine Optimization", "Topical Authority", "Organic Growth"]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};
---
<BaseLayout
  title="Growth OS: An Organic Growth Framework | Bronson Harrington"
  description="Growth OS is Bronson Harrington's three-stage model for sustainable organic growth: Foundations, Growth and Domination. See how each stage works."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <PageHero eyebrow="~/framework" title="Growth OS" subtitle="an organic growth framework · foundations → growth → domination">
    <p class="lede">Sustainable growth isn't about chasing rankings. It's about building something that compounds: structurally sound, increasingly authoritative, and eventually difficult to compete with directly. Growth OS is the model I've refined over 25 years for doing that, in three stages that each build on the one before.</p>
  </PageHero>

  <!-- Stage index: a real sequence, so a numbered flow across the grid -->
  <nav class="container flow" aria-label="Framework stages">
    <ol class="g">
      {phases.map((p) => (
        <li class="s-4">
          <a href={`#${p.id}`}>
            <span class="num">{p.num}</span>
            <span class="name">{p.name.toLowerCase()}</span>
            <span class="arrow" aria-hidden="true">↓</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  {phases.map((p) => (
    <>
      <hr class="hairline" />
      <Section eyebrow={`${p.num} / ${p.name.toLowerCase()}`} title={`${p.name}: ${p.headline}`} id={p.id}>
        <p slot="intro" class="lede">{p.lede}</p>
        <!-- The three disciplines in a stage are peers: one uniform row -->
        <div class="g">
          {p.items.map((it) => (
            <article class="card s-4">
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </article>
          ))}
        </div>
        <div class="hang why">
          <p class="hang-label tag">why it matters</p>
          <p class="hang-body">{p.why}</p>
        </div>
      </Section>
    </>
  ))}

  <hr class="hairline" />

  <Section eyebrow="~/faq" title="Questions About the Framework.">
    <div class="rows">
      {faqs.map((f) => (
        <div class="hang">
          <h3 class="hang-label q">{f.q}</h3>
          <p class="hang-body">{f.a}</p>
        </div>
      ))}
    </div>
  </Section>

  <hr class="hairline" />

  <Section eyebrow="~/next" title="Keep Reading." tight>
    <p slot="intro" class="intro">I write about how these ideas play out in practice in my <a href={`${base}notes/`}>field notes</a>, and the definition behind all of it is on the <a href={`${base}growth-architect-costa-rica/`}>Growth Architect, Costa Rica</a> page. If you want to argue with any of it, <a href={`${base}contact/`}>I'd like to hear from you</a>.</p>
  </Section>
</BaseLayout>

<style>
  .flow {
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    border-top: 0.5px solid var(--hairline);
  }
  .flow ol {
    list-style: none;
    margin: 0;
    padding: 0;
    row-gap: 0;
  }
  .flow a {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
    padding: var(--space-1) 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    border-top: 2px solid var(--rule-strong);
  }
  .flow .num { color: var(--ink-faint); }
  .flow .name { color: var(--ink); }
  .flow .arrow { margin-left: auto; color: var(--ink-faint); }
  .flow a:hover .name,
  .flow a:hover .arrow { color: var(--accent); }
  @media (max-width: 719px) {
    .flow ol { row-gap: var(--space-1); }
  }
  @media (min-width: 720px) and (max-width: 979px) {
    .flow li.s-4 { grid-column: span 8; }
  }
  @media (min-width: 720px) and (max-width: 979px) {
    .card.s-4 { grid-column: span 8; }
  }
  .why {
    margin-top: var(--space-5);
  }
  .why .hang-body {
    margin: 0;
    color: var(--ink-soft);
  }
  .q {
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--ink);
    padding-top: 0;
  }
  .rows .hang-body {
    margin: 0;
    color: var(--ink-soft);
  }
  .intro a,
  .rows a {
    color: var(--accent);
  }
</style>

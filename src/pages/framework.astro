---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const faqs = [
  {
    q: "What is a Growth Architect?",
    a: "A Growth Architect helps businesses build the foundations, systems, and strategies required for sustainable growth. Unlike a traditional designer, SEO specialist, or consultant who focuses on a single discipline, a Growth Architect looks at how branding, websites, search visibility, content, automation, analytics, and business strategy work together to support long-term success. The goal isn't simply to deliver services, but to create the conditions that help businesses grow."
  },
  {
    q: "Should I invest in a new website, SEO, or business strategy first?",
    a: "It depends on where your business is today. A business with no clear brand or website often benefits from strengthening its foundations first. A business with a strong website but limited visibility may benefit most from SEO and content strategy. An established organization with strong traffic and lead flow may see greater returns from automation, systems optimization, and strategic growth planning. The right answer isn't always more marketing, it's identifying the next constraint preventing growth."
  },
  {
    q: "How do I know whether I need Foundations, Growth, or Domination services?",
    a: "Most businesses naturally fit into one of three stages. Foundations: you need a stronger brand, website, messaging, or online presence. Growth: you have a solid foundation but want more visibility, leads, and customers. Domination: you already have traction and need strategic guidance, automation, systems, or leadership support to scale effectively. If you're unsure, we'll identify the most appropriate starting point during an initial discovery conversation."
  },
  {
    q: "Do I need to start with Foundations?",
    a: "Not necessarily. Many businesses already have a website, branding, or existing marketing assets in place. In those cases, we may begin with Growth or Domination services. Every engagement starts by evaluating where your business is today and identifying the opportunities that will have the greatest impact."
  },
  {
    q: "Can I hire you for a single service?",
    a: "Absolutely. While services are organized around business growth stages, many clients engage me for specific projects such as website development, SEO, content strategy, brand development, AI implementation, or business consulting. The framework simply helps ensure each service supports your broader business goals."
  },
  {
    q: "What industries do you work with?",
    a: "I work with a wide variety of businesses and organizations, including professional service firms, trades and contractors, local businesses, startups, e-commerce brands, non-profit organizations, tourism and hospitality businesses, and online gaming brands (casino, sportsbook, poker, bingo). The common factor isn't the industry, but a commitment to growth."
  },
  {
    q: "How long does a typical project take?",
    a: "Project timelines vary depending on scope and complexity. As a general guide: branding projects take 1 to 2 weeks, website projects take 2 to 12 weeks, SEO and growth engagements run 90 days plus ongoing support, and strategic consulting is tailored to business needs. A clear timeline and deliverables are established before any work begins."
  },
  {
    q: "Do you offer ongoing support?",
    a: "Yes. Many clients continue working with me after a project launch to maintain momentum and pursue new growth opportunities. Ongoing support may include website maintenance, SEO, content strategy, analytics and reporting, marketing automation, growth consulting, and strategic advisory."
  },
  {
    q: "What makes your approach different from a traditional agency?",
    a: "Most agencies focus on delivering marketing services. My approach focuses on business growth. That means every recommendation is evaluated through the lens of business outcomes rather than individual tactics. Instead of asking 'do you need SEO', I ask what is preventing your business from reaching its next stage of growth. The answer often involves a combination of branding, technology, marketing, automation, and strategy."
  },
  {
    q: "Do you use AI in your process?",
    a: "Yes, strategically. AI can improve efficiency, streamline workflows, accelerate content creation, and support decision-making when implemented correctly. I help businesses identify practical applications for AI that create measurable value rather than chasing trends. The goal is always better outcomes, not simply adopting new technology."
  },
  {
    q: "How do you measure success?",
    a: "Success depends on your goals. For some businesses, success means launching a professional brand and website. For others, it may mean increased search visibility, more qualified leads, improved conversion rates, greater operational efficiency, revenue growth, or stronger market positioning. Every project begins by defining clear objectives and identifying the metrics that matter most."
  },
  {
    q: "Do you work with businesses outside your local area?",
    a: "Yes. Many projects can be delivered remotely, allowing me to work with businesses across the USA, EU, LATAM, and internationally. Communication is managed through video calls, email, collaboration tools, and regular project updates."
  },
  {
    q: "What does it cost to work together?",
    a: "Every business is different. Foundations projects are generally structured around defined deliverables, while Growth and Domination engagements are often ongoing partnerships. After an initial conversation, I'll recommend the most appropriate approach based on your goals, challenges, and stage of growth."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---
<BaseLayout
  title="Organic Growth Framework by Bronson Harrington"
  description="The Organic Growth Framework is a blueprint for enhancing your brand, building your authority, and boosting your business growth. Ready to grow? Let's go!"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="hero container">
    <p class="eyebrow">~/framework</p>
    <h1>Build your brand. Grow your business. Dominate your market.</h1>
    <p class="lede">From strategic branding and high-converting websites to SEO and growth marketing, I help businesses create a stronger foundation, generate more opportunities, and achieve sustainable growth.</p>
  </section>

  <hr class="hairline" />

  <section class="phase-flow container" aria-hidden="true">
    <div class="flow-node">01</div>
    <div class="flow-line"></div>
    <div class="flow-node">02</div>
    <div class="flow-line"></div>
    <div class="flow-node">03</div>
  </section>

  <section class="phase container" id="foundations">
    <p class="eyebrow">01 / foundations</p>
    <h2>Build a strong brand that creates clarity, credibility, and lasting impact.</h2>
    <p class="lede">Every successful business starts with a solid foundation, one that helps customers understand who you are, what you do, and why they should choose you.</p>

    <div class="service-list">
      <article class="service-item">
        <h3>Brand Strategy</h3>
        <p class="tagline">Define your position before you promote it.</p>
        <p>Create a clear strategic direction that aligns your business, audience, messaging, and market position. Brand strategy provides the foundation for every future marketing and growth initiative.</p>
      </article>
      <article class="service-item">
        <h3>Brand Identity</h3>
        <p class="tagline">Build a brand people recognise and remember.</p>
        <p>Develop a professional visual identity that creates trust, strengthens recognition, and supports long-term growth across every touchpoint.</p>
      </article>
      <article class="service-item">
        <h3>Brand Messaging</h3>
        <p class="tagline">Communicate your value with confidence.</p>
        <p>Craft clear, compelling messaging that connects with the right audience and inspires action, creating a consistent voice that builds trust.</p>
      </article>
    </div>
    <a href={`${base}framework/foundations/`} class="phase-link">explore foundations &#8594;</a>
  </section>

  <hr class="hairline" />

  <section class="phase container" id="growth">
    <p class="eyebrow">02 / growth</p>
    <h2>Build the digital assets, systems, and infrastructure that turn potential into performance.</h2>
    <p class="lede">Once your brand foundation is established, it's time to build the platforms, processes, and content engines that support sustainable growth.</p>

    <div class="service-list">
      <article class="service-item">
        <h3>Website Development</h3>
        <p class="tagline">Build a digital presence that works as hard as you do.</p>
        <p>Create a professional website designed to attract visitors, build trust, and generate opportunities, combining strong branding with conversion-focused design.</p>
      </article>
      <article class="service-item">
        <h3>Content Systems</h3>
        <p class="tagline">Create content that attracts, educates, and converts.</p>
        <p>Develop scalable content frameworks that support visibility, engagement, and long-term growth through strategic planning and structured publishing.</p>
      </article>
      <article class="service-item">
        <h3>Digital Systems</h3>
        <p class="tagline">Build the infrastructure that powers growth.</p>
        <p>Implement the systems needed to measure performance, improve experiences, and support growth through analytics, automation, and journey improvements.</p>
      </article>
    </div>
    <a href={`${base}framework/growth/`} class="phase-link">explore growth &#8594;</a>
  </section>

  <hr class="hairline" />

  <section class="phase container" id="domination">
    <p class="eyebrow">03 / domination</p>
    <h2>Increase visibility, strengthen authority, and accelerate growth.</h2>
    <p class="lede">With the right foundations and systems in place, it's time to amplify your reach, expand your influence, and create sustainable competitive advantage.</p>

    <div class="service-list">
      <article class="service-item">
        <h3>Search Optimisation</h3>
        <p class="tagline">Increase visibility where your customers are searching.</p>
        <p>Improve your presence across search engines and emerging AI-powered discovery platforms through technical SEO, content optimisation, and AI search readiness.</p>
      </article>
      <article class="service-item">
        <h3>Authority Building</h3>
        <p class="tagline">Become the trusted choice in your market.</p>
        <p>Strengthen your reputation through strategic content, thought leadership, digital PR, and reputation-building initiatives that establish lasting credibility.</p>
      </article>
      <article class="service-item">
        <h3>Growth Strategy</h3>
        <p class="tagline">Turn insights into action and momentum.</p>
        <p>Develop strategic roadmaps combining positioning, authority building, and sustained visibility to move beyond inclusion into market dominance.</p>
      </article>
    </div>
    <a href={`${base}framework/domination/`} class="phase-link">explore domination &#8594;</a>
  </section>

  <hr class="hairline" />

  <section class="process container">
    <p class="eyebrow">how it works</p>
    <h2>Turn insight into action.</h2>
    <p class="lede">A simple process designed to uncover opportunities, prioritize growth initiatives, and create a clear path forward.</p>

    <div class="process-grid">
      <article class="process-step">
        <p class="label">01 / request an audit</p>
        <h3>Understand your business</h3>
        <p>Book a free discovery call to request your free audit, discuss your business, your goals, and your current challenges. Growth starts here.</p>
      </article>
      <article class="process-step">
        <p class="label">02 / receive your results</p>
        <h3>Identify the opportunities</h3>
        <p>Personalized audit and strategic growth blueprint highlighting opportunities across Foundations, Growth, and Domination.</p>
      </article>
      <article class="process-step">
        <p class="label">03 / work the plan</p>
        <h3>Build the roadmap</h3>
        <p>Review the findings, recommendations, and next steps through a recorded presentation designed to help you take action.</p>
      </article>
    </div>
  </section>

  <hr class="hairline" />

  <section class="faq container">
    <p class="eyebrow">frequently asked questions</p>
    <h2>Questions about branding, websites, SEO, or business growth?</h2>
    <p class="lede">Explore the answers below, and if you'd like tailored advice for your business, let's start a conversation.</p>

    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <hr class="hairline" />

  <section class="final-cta container">
    <p class="eyebrow">free for igaming and regulated operators</p>
    <h2>Get your 90-day growth plan.</h2>
    <p class="lede">The Foundations, Growth, and Domination framework applied to your actual site. Personal video walkthrough built from your real data.</p>
    <a href={`${base}contact/`} class="cta-btn">request your free blueprint &#8594;</a>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-6);
    padding-bottom: var(--space-5);
  }
  .hero .lede {
    font-size: var(--text-lg);
    color: var(--ink-soft);
    max-width: var(--content-narrow);
    margin-top: var(--space-2);
  }
  .phase-flow {
    display: flex;
    align-items: center;
    padding: var(--space-4) 0;
  }
  .flow-node {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-faint);
    border: 0.5px solid var(--hairline);
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .flow-line {
    height: 0.5px;
    background: var(--hairline);
    flex: 1;
  }
  .phase {
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }
  .phase .lede {
    color: var(--ink-soft);
    max-width: var(--content-narrow);
    margin: var(--space-2) 0 var(--space-5);
  }
  .service-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    margin-bottom: var(--space-4);
  }
  .service-item {
    border-top: 2px solid var(--ink);
    padding-top: var(--space-3);
  }
  .service-item .tagline {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    margin: var(--space-1) 0 var(--space-2);
  }
  .service-item p:not(.tagline) {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .phase-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    text-decoration: none;
  }
  .process {
    padding-top: var(--space-6);
    padding-bottom: var(--space-7);
  }
  .process .lede {
    color: var(--ink-soft);
    max-width: var(--content-narrow);
    margin: var(--space-2) 0 var(--space-5);
  }
  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .process-step h3 {
    margin: var(--space-1) 0 var(--space-2);
  }
  .process-step p:not(.label) {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .faq {
    padding-top: var(--space-6);
    padding-bottom: var(--space-7);
  }
  .faq .lede {
    color: var(--ink-soft);
    max-width: var(--content-narrow);
    margin: var(--space-2) 0 var(--space-5);
  }
  .faq-list {
    display: flex;
    flex-direction: column;
  }
  .faq-item {
    border-top: 0.5px solid var(--hairline);
    padding: var(--space-3) 0;
  }
  .faq-item:last-child {
    border-bottom: 0.5px solid var(--hairline);
  }
  .faq-item summary {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-base);
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::before {
    content: '+';
    display: inline-block;
    width: 1em;
    color: var(--accent);
    font-family: var(--font-mono);
  }
  .faq-item[open] summary::before {
    content: '\2212';
  }
  .faq-item p {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin-top: var(--space-2);
    padding-left: 1em;
  }
  .final-cta {
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
    text-align: center;
  }
  .final-cta .lede {
    max-width: var(--content-narrow);
    margin: var(--space-2) auto var(--space-4);
    color: var(--ink-soft);
  }
  .cta-btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    text-decoration: none;
    background: var(--ink);
    color: var(--paper);
  }
  .cta-btn:hover {
    background: var(--accent);
  }
  @media (max-width: 860px) {
    .service-list { grid-template-columns: 1fr; }
    .process-grid { grid-template-columns: 1fr; }
  }
</style>

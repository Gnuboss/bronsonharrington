---
import Layout from '../layouts/Layout.astro'; // Adjust layout path if needed
---
<Layout title="Field Notes - Bronson Harrington">
  <main class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-2">Field Notes</h1>
    <p class="text-lg text-muted-foreground mb-8">Strategic insights, technical growth breakdowns, and SEO frameworks from the field.</p>
    
    <!-- Blog Post Feed Stubs -->
    <div class="space-y-8 border-t border-border pt-8">
      <article class="group">
        <span class="text-sm text-muted-foreground">September 2026</span>
        <h2 class="text-2xl font-bold mt-1 group-hover:text-primary transition-colors">
          <a href="/field-notes/first-entry">Engineering Growth: Architecting Scalable Acquisition Pipelines</a>
        </h2>
        <p class="text-muted-foreground mt-2">An introduction to systemizing enterprise SEO architectures and acquisition loops...</p>
      </article>
    </div>
  </main>
</Layout>

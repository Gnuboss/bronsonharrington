---
// Lab experiment: a vertical scroller. An original ocean scene drawn in SVG,
// split into layers that move at different speeds as you scroll (parallax),
// so reading the page feels like diving: sky, surface, open water, seabed.
// It tells Growth OS from the top down: Domination is what everyone sees on
// the surface, Growth is the open water, Foundations is the seabed.
// Field note: src/content/notes/vertical-scroller-parallax-experiment.md
//
// The scene itself lives in src/components/OceanScene.astro.
import BaseLayout from '../../layouts/BaseLayout.astro';
import OceanScene from '../../components/OceanScene.astro';

const base = import.meta.env.BASE_URL;

// Depth gauge marks: each is pinned to its section
const marks = [
  { id: 'surface', depth: '0m', label: 'surface' },
  { id: 'domination', depth: '20m', label: 'domination' },
  { id: 'growth', depth: '60m', label: 'growth' },
  { id: 'foundations', depth: '110m', label: 'foundations' },
];
---
<BaseLayout
  title="Vertical Scroller: A Growth OS Dive | Bronson Harrington"
  description="A lab experiment: an SVG parallax ocean you dive through as you scroll, telling Growth OS from the surface down to the seabed it stands on."
>
  <OceanScene marks={marks} seabed="foundations" />

  <!-- The page: four stops on the way down -->
  <div class="dive">
    <section class="stop container" id="surface">
      <div class="card hero">
        <p class="tag">~/lab/scroller</p>
        <h1>Dive in.</h1>
        <p class="lede">Everything you see on the surface stands on what's underneath. Scroll down: this is Growth OS from the top, the way the market sees it, to the seabed it's built on.</p>
        <p class="hint">scroll ↓</p>
      </div>
    </section>

    <section class="stop container" id="domination">
      <div class="card">
        <p class="tag">20m / domination</p>
        <h2>What everyone sees.</h2>
        <p>Being recommended, cited and chosen: in search rankings, answer engines and generative search. It's the part above the waterline, and the part most people try to start with.</p>
        <a class="more" href={`${base}services/#domination`}>the domination course →</a>
      </div>
    </section>

    <section class="stop container" id="growth">
      <div class="card">
        <p class="tag">60m / growth</p>
        <h2>The open water.</h2>
        <p>Reach that keeps expanding: content that closes the gaps, topical depth, and a footprint that grows beyond your own site. Most of the volume lives here, out of sight.</p>
        <a class="more" href={`${base}services/#growth`}>the growth course →</a>
      </div>
    </section>

    <section class="stop container" id="foundations">
      <div class="card">
        <p class="tag">110m / foundations</p>
        <h2>The seabed.</h2>
        <p>What everything stands on: a clear position, a site built properly, and technical health that lets search engines find and trust it all. Nobody sees it. Nothing above it holds without it.</p>
        <a class="more" href={`${base}services/#foundations`}>the foundations course →</a>
      </div>
    </section>

    <section class="stop container surfacing">
      <div class="card">
        <p class="tag">~/surface</p>
        <h2>Come back up.</h2>
        <p>This is a lab experiment; <a href={`${base}notes/vertical-scroller-parallax-experiment/`}>the field note</a> explains how it's built. The real thing is on the <a href={`${base}framework/`}>framework</a>, <a href={`${base}services/`}>services</a> and <a href={`${base}solutions/`}>solutions</a> pages.</p>
        <a class="more" href="#surface">back to the surface ↑</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Content ------------------------------------------------------------------ */
  .stop {
    min-height: 110vh;
    display: flex;
    align-items: center;
  }
  .card {
    max-width: 520px;
    background: var(--paper);
    border-top: 2px solid var(--rule-strong);
    padding: var(--space-4);
    box-shadow: 0 10px 40px rgba(var(--ink-rgb), 0.18);
  }
  .card h1 {
    margin: var(--space-1) 0 var(--space-2);
  }
  .card h2 {
    margin: var(--space-1) 0 var(--space-2);
  }
  .card p:last-child {
    margin-bottom: 0;
  }
  .card a {
    color: var(--accent);
  }
  .card .more {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .hint {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }
  @media (max-width: 720px) {
    /* Leave the gauge its own strip on the right */
    .dive .container { padding-right: 52px; }
    .card { padding: var(--space-3); }
  }
</style>

---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PixelGrid from '../components/PixelGrid.astro';
import TopBar from '../components/TopBar.astro';
import ThumbNav from '../components/ThumbNav.astro';
import '../styles/tokens.css';
import '../styles/grid.css';
import { GA_MEASUREMENT_ID, GSC_VERIFICATION } from '../config/site';
import { palette } from '../config/palette.mjs';
import { buildTokens, toCss } from '../config/theme.mjs';

const tokens = buildTokens(palette);

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content={tokens['--paper']} />
  <!-- Palette {palette.edition}: {palette.name}. Inline so colours apply before any CSS file loads -->
  <style is:inline set:html={toCss(tokens)}></style>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="alternate" type="application/rss+xml" title="Bronson Harrington - Field Notes" href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <slot name="head" />

  <!-- Mobile nav test: puts each visitor in the "top" (header links) or
       "radial" (thumb nav) group, 50/50, and keeps them there. Runs before
       paint so the page never flashes the wrong nav. ?nav=top or ?nav=radial
       forces a group (handy for previewing). Only phones (<=720px) see a difference. -->
  <script is:inline>
    (function () {
      var v = 'top';
      try {
        var q = new URLSearchParams(location.search).get('nav');
        var saved = localStorage.getItem('navVariant');
        if (q === 'top' || q === 'radial') v = q;
        else if (saved === 'top' || saved === 'radial') v = saved;
        else v = Math.random() < 0.5 ? 'top' : 'radial';
        localStorage.setItem('navVariant', v);
      } catch (e) {}
      document.documentElement.setAttribute('data-nav', v);
    })();
  </script>

  {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}

  {GA_MEASUREMENT_ID && (
    <>
      <!-- Google Analytics 4: async, so it never blocks rendering -->
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
      <script is:inline define:vars={{ id: GA_MEASUREMENT_ID }}>
        window.dataLayer = window.dataLayer || [];
        // Global, so the click-tracking script can send events
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        // Nav test group, so every report can be split by it
        window.gtag('set', 'user_properties', { nav_variant: document.documentElement.getAttribute('data-nav') });
        window.gtag('config', id);
      </script>
    </>
  )}

  <!-- Self-hosted fonts, subsetted, woff2 only -->
  <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jetbrains-mono-var.woff2" as="font" type="font/woff2" crossorigin />
  <style is:global>
    @font-face {
      font-family: 'Inter';
      src: url('/fonts/inter-var.woff2') format('woff2');
      font-weight: 100 900;
      font-display: swap;
    }
    @font-face {
      font-family: 'JetBrains Mono';
      src: url('/fonts/jetbrains-mono-var.woff2') format('woff2');
      font-weight: 100 800;
      font-display: swap;
    }
  </style>
</head>
<body>
  <PixelGrid />
  <TopBar />
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <ThumbNav />
  <!-- GA4 events: email and phone taps anywhere on the site (no-op until the GA tag has loaded) -->
  <script>
    document.addEventListener('click', (event) => {
      const link = (event.target as Element | null)?.closest?.('a[href]');
      const gtag = (window as any).gtag;
      if (!link || typeof gtag !== 'function') return;
      const href = link.getAttribute('href') ?? '';
      const location = link.closest('[data-track-location]')?.getAttribute('data-track-location') ?? 'page';
      const nav_variant = document.documentElement.getAttribute('data-nav') ?? 'top';
      if (href.startsWith('tel:')) gtag('event', 'phone_click', { link_location: location, nav_variant });
      else if (href.startsWith('mailto:')) gtag('event', 'email_click', { link_location: location, nav_variant });
      else if (location === 'header_nav' || location === 'thumb_nav') {
        gtag('event', 'nav_click', { link_location: location, link_text: link.textContent?.trim(), nav_variant });
      }
    });
  </script>
</body>
</html>
